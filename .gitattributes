# Detectar automáticamente archivos de texto y normalizar saltos de línea a LF
* text=auto

# Archivos de código y plantillas con saltos de línea estándar (LF)
*.js text eol=lf
*.json text eol=lf
*.ejs text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Archivos binarios (como tus imágenes PNG en public/bootstrap/img/)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# === Anadido por scripts/setup.mjs ===
*.mjs text eol=lf
