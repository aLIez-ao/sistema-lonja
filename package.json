{
  "name": "sistema-lonja",
  "version": "1.0.0",
  "description": "Sistema Lonja de Veracruz: registro de compras, control de acceso y reporte diario",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "server": "nodemon index.js",
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-lines=80 test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write app.js index.js \"{config,controllers,helpers,migraciones,middleware,models,routes,scripts,servicios,test,public/js}/**/*.js\" package.json eslint.config.js .prettierrc.json",
    "format:check": "prettier --check app.js index.js \"{config,controllers,helpers,migraciones,middleware,models,routes,scripts,servicios,test,public/js}/**/*.js\" package.json eslint.config.js .prettierrc.json",
    "demo": "node scripts/demo.js",
    "correo:configurar": "node scripts/configurar-correo.js"
  },
  "author": "Ardan Olvera",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "method-override": "^3.0.0",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "sqlite3": "^6.0.1"
  }
}
