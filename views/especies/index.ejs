<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('especies') %></h1>
    <p class="text-muted small mb-0">Catálogo de especies marinas registradas por lote</p>
  </div>
  <a class="btn btn-primary" href="/especies/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    Nueva especie
  </a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0" data-orden-servidor>
      <thead>
        <tr>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'id', titulo: 'ID' }) %>
          <th data-no-sort>Imagen</th>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'nombre', titulo: 'Nombre' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'tipo', titulo: 'Tipo' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'lote', titulo: 'Lote' }) %>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% if (!especies.length) { %>
        <tr class="fila-vacia">
          <td colspan="6" class="text-center py-4 text-muted">
            <%= (l.q || Object.keys(l.filtros).length) ? 'No hay registros que coincidan con la búsqueda.' : 'No hay especies registradas en el sistema.' %>
          </td>
        </tr>
      <% } %>
      <% especies.forEach(e => { %>
        <tr>
          <td><%= e.id_epe %></td>
          <td>
            <% if (e.imagen) { %>
              <img src="<%= e.imagen %>" alt="<%= e.nombre %>" height="38" class="rounded border" onerror="this.style.display='none'">
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td><strong><%= e.nombre %></strong></td>
          <td><span class="badge bg-body-tertiary text-body border"><%= e.tipo.nombre %></span></td>
          <td><span class="badge bg-secondary">#<%= e.id_lte %></span></td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-secondary" href="/especies/<%= e.id_epe %>/editar" title="Editar especie" aria-label="Editar especie">
              <%- icono('pencil', 14) %>
            </a>
            <% if (usuario.rol === 'admin') { %>
            <form action="/especies/<%= e.id_epe %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar esta especie?')">
              <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar especie" aria-label="Eliminar especie">
                <%- icono('trash', 14) %>
              </button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../plantillas/paginacion', { l, etiqueta: 'especies' }) %>
<%- include('../plantillas/footer') %>
