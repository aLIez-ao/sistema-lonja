<%- include('../plantillas/header') %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-5 col-xl-4">
    <div class="card login-card p-4">
      <div class="login-brand text-center mb-3">
        <img src="/img/logo.svg" alt="Lonja de Veracruz" style="max-height: 52px;">
      </div>
      <h1 class="h4 text-center mb-1 fw-bold">Nueva Contraseña</h1>
      <p class="text-center text-muted small mb-4">Crea una nueva contraseña segura para tu cuenta de <strong><%= usuario.usuario %></strong>.</p>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>

      <form action="/recuperar-password/<%= token %>" method="POST">
        <div class="mb-3">
          <label for="password" class="form-label fw-semibold">Nueva Contraseña</label>
          <input type="password" class="form-control" id="password" name="password" minlength="8" required autofocus>
          <div class="form-text">Mínimo 8 caracteres.</div>
        </div>
        <div class="mb-3">
          <label for="password_confirmar" class="form-label fw-semibold">Confirmar Contraseña</label>
          <input type="password" class="form-control" id="password_confirmar" name="password_confirmar" minlength="8" required>
        </div>
        <button class="btn btn-primary w-100 mb-3" type="submit">Restablecer y Entrar</button>
      </form>
    </div>
  </div>
</div>
<%- include('../plantillas/footer') %>
