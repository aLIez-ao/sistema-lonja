<%- include('../plantillas/header') %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-5 col-xl-4">
    <div class="card login-card p-4">
      <div class="login-brand text-center mb-3">
        <img src="/img/logo.svg" alt="Lonja de Veracruz" width="252" height="52">
      </div>
      <h1 class="h4 text-center mb-1 fw-bold">Crea tu contraseña</h1>
      <p class="text-center text-muted small mb-4">Cuenta: <strong><%= cuenta.usuario %></strong> (<%= cuenta.nombre_completo %>)</p>

      <%- include('../plantillas/mensajes', { mensaje: null }) %>

      <form action="/recuperar-password/<%= token %>" method="POST" novalidate data-validar>
        <%- include('../plantillas/campo-password', { nombre: 'password', etiqueta: 'Contraseña nueva', requerido: true }) %>
        <button class="btn btn-primary w-100 mb-2" type="submit">Guardar contraseña</button>
        <p class="small text-muted text-center mb-0">Al guardarla se cerrarán las sesiones abiertas en otros dispositivos.</p>
      </form>
    </div>
  </div>
</div>
<%- include('../plantillas/footer') %>
