<%- include('../plantillas/header') %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-5 col-xl-4">
    <div class="card login-card p-4">
      <div class="login-brand text-center mb-3">
        <img src="/img/logo.svg" alt="Lonja de Veracruz" style="max-height: 52px;">
      </div>
      <h1 class="h4 text-center mb-1 fw-bold">Recuperar Contraseña</h1>
      <p class="text-center text-muted small mb-4">Ingresa el correo electrónico vinculado a tu cuenta para recibir un enlace de restablecimiento.</p>
      
      <% if (typeof mensaje !== 'undefined' && mensaje) { %>
        <div class="alert alert-success" role="alert"><%= mensaje %></div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>

      <form action="/olvide-password" method="POST">
        <div class="mb-3">
          <label for="correo" class="form-label fw-semibold">Correo Electrónico</label>
          <input type="email" class="form-control" id="correo" name="correo" required placeholder="tu-correo@ejemplo.com" autofocus>
        </div>
        <button class="btn btn-primary w-100 mb-3" type="submit">Enviar Enlace</button>
        <div class="text-center">
          <a href="/" class="small text-decoration-none">&larr; Volver a Iniciar Sesión</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../plantillas/footer') %>
