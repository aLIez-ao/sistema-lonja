<%- include('../plantillas/header') %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-5 col-xl-4">
    <div class="card login-card p-4">
      <div class="login-brand text-center mb-3">
        <img src="/img/logo.svg" alt="Lonja de Veracruz" width="252" height="52">
      </div>
      <h1 class="h4 text-center mb-1 fw-bold">Recuperar contraseña</h1>
      <p class="text-center text-muted small mb-4">Escribe tu correo o tu nombre de usuario. Te enviaremos al correo de tu cuenta un enlace para crear una contraseña nueva.</p>

      <% if (mensaje) { %><div class="alert alert-success" role="alert"><%= mensaje %></div><% } %>
      <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

      <% if (!mensaje) { %>
        <form action="/olvide-password" method="POST">
          <div class="mb-3">
            <label for="identificador" class="form-label fw-semibold">Correo o usuario</label>
            <input type="text" class="form-control" id="identificador" name="identificador" maxlength="80" required autofocus autocomplete="username">
          </div>
          <button class="btn btn-primary w-100 mb-3" type="submit">Enviar enlace</button>
        </form>
        <p class="small text-muted">El enlace vence en 1 hora y solo sirve una vez. Si tu cuenta no tiene correo registrado, pide a un administrador que restablezca tu acceso.</p>
      <% } %>
      <div class="text-center">
        <a href="/" class="small text-decoration-none"><%- icono('arrow-left', 13, 'me-1') %>Volver a iniciar sesión</a>
      </div>
    </div>
  </div>
</div>
<%- include('../plantillas/footer') %>
