<%- include('../plantillas/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('compras') %></h1>
    <p class="text-muted small mb-0">Registro histórico de adjudicaciones y facturación</p>
  </div>
  <a class="btn btn-primary" href="/compras/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    <%= t('registrar_compra') %>
  </a>
</div>

<%- include('../plantillas/mensajes', { errores: [] }) %>

<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0 table-sortable">
      <thead>
        <tr>
          <th>Fecha y Hora</th>
          <th>Lote</th>
          <th>Especies</th>
          <th>Comprador</th>
          <th class="text-end">Kilos</th>
          <th class="text-end">Precio Final/kg</th>
          <th class="text-end">Total</th>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (compras.length === 0) { %>
          <tr class="fila-vacia">
            <td colspan="8" class="text-center py-4 text-muted">
              No hay compras registradas en el sistema.
            </td>
          </tr>
        <% } %>
        <% compras.forEach(c => { %>
          <tr>
            <td data-sort-value="<%= new Date(c.fecha).getTime() %>"><%= fechaHora(c.fecha) %></td>
            <td><span class="badge bg-secondary">#<%= c.id_cmp %></span></td>
            <td><strong><%= c.lote.especies.map(e => e.nombre).join(', ') || '—' %></strong></td>
            <td><%= c.comprador.nombre %> <%= c.comprador.apellido_paterno %></td>
            <td class="text-end"><%= Number(c.lote.kilos).toFixed(2) %> kg</td>
            <td class="text-end"><%= dinero(c.precio_kilo_final) %></td>
            <td class="text-end text-primary fw-bold"><%= dinero(c.precio_total) %></td>
            <td class="text-end text-nowrap">
              <!-- Factura Detalle -->
              <a class="btn btn-sm btn-outline-primary" href="/compras/<%= c.id_cmp %>/factura" title="Ver factura" aria-label="Ver factura">
                <%- icono('receipt', 14) %>
              </a>

              <!-- Descargar PDF directo -->
              <a class="btn btn-sm btn-outline-secondary" href="/compras/<%= c.id_cmp %>/factura.pdf" title="Descargar factura en PDF" aria-label="Descargar factura en PDF">
                <%- icono('download', 14) %>
              </a>

              <!-- Editar -->
              <a class="btn btn-sm btn-outline-secondary" href="/compras/<%= c.id_cmp %>/editar" title="Editar compra" aria-label="Editar compra">
                <%- icono('pencil', 14) %>
              </a>

              <% if (usuario.rol === 'admin') { %>
                <form action="/compras/<%= c.id_cmp %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar esta compra? El lote volverá a quedar disponible.')">
                  <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar compra" aria-label="Eliminar compra">
                    <%- icono('trash', 14) %>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% const enlacePagina = (n) => `/compras?pagina=${n}&tam=${tam}`; %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
  <form method="GET" action="/compras" class="d-flex align-items-center gap-2 mb-0">
    <label for="tam" class="small text-muted mb-0">Filas por página</label>
    <select id="tam" name="tam" class="form-select form-select-sm w-auto">
      <% porPagina.forEach(n => { %>
        <option value="<%= n %>" <%= n === tam ? 'selected' : '' %>><%= n %></option>
      <% }) %>
    </select>
    <button class="btn btn-sm btn-outline-secondary" type="submit">Aplicar</button>
  </form>

  <span class="small text-muted">Mostrando <%= inicio %>–<%= fin %> de <%= total %> compras</span>

  <nav aria-label="Paginación de compras">
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= pagina <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="<%= enlacePagina(pagina - 1) %>" aria-label="Página anterior">&laquo;</a>
      </li>
      <li class="page-item disabled"><span class="page-link">Página <%= pagina %> de <%= paginas %></span></li>
      <li class="page-item <%= pagina >= paginas ? 'disabled' : '' %>">
        <a class="page-link" href="<%= enlacePagina(pagina + 1) %>" aria-label="Página siguiente">&raquo;</a>
      </li>
    </ul>
  </nav>
</div>

<%- include('../plantillas/footer') %>
