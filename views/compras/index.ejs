<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Compras</h1>
  <a class="btn btn-primary" href="/compras/crear">Registrar compra</a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<p class="text-muted small">Se muestran las 200 compras más recientes. Para un día específico usa el <a href="/reportes/diario">reporte diario</a>.</p>
<div class="table-responsive">
<table class="table table-striped align-middle">
  <thead><tr><th>Fecha</th><th>Lote</th><th>Especies</th><th>Comprador</th><th>Kilos</th><th>Precio final/kg</th><th>Total</th><th class="text-end">Acciones</th></tr></thead>
  <tbody>
  <% compras.forEach(c => { %>
    <tr>
      <td><%= fechaHora(c.fecha) %></td>
      <td><%= c.id_cmp %></td>
      <td><%= c.lote.especies.map(e => e.nombre).join(', ') || '—' %></td>
      <td><%= c.comprador.nombre %> <%= c.comprador.apellido_paterno %></td>
      <td><%= Number(c.lote.kilos).toFixed(2) %></td>
      <td><%= dinero(c.precio_kilo_final) %></td>
      <td><strong><%= dinero(c.precio_total) %></strong></td>
      <td class="text-end text-nowrap">
        <a class="btn btn-sm btn-outline-secondary" href="/compras/<%= c.id_cmp %>/editar">Editar</a>
        <% if (usuario.rol === 'admin') { %>
        <form action="/compras/<%= c.id_cmp %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar esta compra? El lote quedará disponible.')">
          <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('../plantillas/footer') %>
