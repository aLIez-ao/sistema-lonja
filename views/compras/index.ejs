<%- include('../plantillas/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('compras') %></h1>
    <p class="text-muted small mb-0">Registro histórico de adjudicaciones y facturación</p>
  </div>
  <a class="btn btn-primary" href="/compras/crear">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
    <%= t('registrar_compra') %>
  </a>
</div>

<%- include('../plantillas/mensajes', { errores: [] }) %>

<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0">
      <thead>
        <tr>
          <th>Fecha y Hora</th>
          <th>Lote</th>
          <th>Especies</th>
          <th>Comprador</th>
          <th class="text-end">Kilos</th>
          <th class="text-end">Precio Final/kg</th>
          <th class="text-end">Total</th>
          <th class="text-end">Factura y Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (compras.length === 0) { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              No hay compras registradas en el sistema.
            </td>
          </tr>
        <% } %>
        <% compras.forEach(c => { %>
          <tr>
            <td><%= fechaHora(c.fecha) %></td>
            <td><span class="badge bg-secondary">#<%= c.id_cmp %></span></td>
            <td><strong><%= c.lote.especies.map(e => e.nombre).join(', ') || '—' %></strong></td>
            <td><%= c.comprador.nombre %> <%= c.comprador.apellido_paterno %></td>
            <td class="text-end"><%= Number(c.lote.kilos).toFixed(2) %> kg</td>
            <td class="text-end"><%= dinero(c.precio_kilo_final) %></td>
            <td class="text-end text-primary fw-bold"><%= dinero(c.precio_total) %></td>
            <td class="text-end text-nowrap">
              <!-- Factura Detalle -->
              <a class="btn btn-sm btn-outline-primary" href="/compras/<%= c.id_cmp %>/factura" title="Ver Comprobante / Factura">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/></svg>
                Factura
              </a>

              <!-- Descargar PDF directo -->
              <a class="btn btn-sm btn-outline-secondary" href="/compras/<%= c.id_cmp %>/factura.pdf" title="Descargar PDF">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
              </a>

              <!-- Editar -->
              <a class="btn btn-sm btn-outline-secondary" href="/compras/<%= c.id_cmp %>/editar" title="Editar">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/></svg>
              </a>

              <% if (usuario.rol === 'admin') { %>
                <form action="/compras/<%= c.id_cmp %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar esta compra? El lote volverá a quedar disponible.')">
                  <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../plantillas/footer') %>
