<%- include('../plantillas/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 d-print-none">
  <div>
    <a href="/compras" class="btn btn-sm btn-outline-secondary mb-1">&larr; Volver a Compras</a>
    <h1 class="h3 mb-0 fw-bold">Factura de Compra #FAC-<%= String(compra.id_cmp).padStart(6, '0') %></h1>
  </div>

  <div class="d-flex gap-2 flex-wrap">
    <!-- Descargar PDF -->
    <a class="btn btn-primary" href="/compras/<%= compra.id_cmp %>/factura.pdf">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
      <%= t('descargar_pdf') %>
    </a>

    <!-- Compartir -->
    <button class="btn btn-outline-secondary" type="button" onclick="compartirEnlace('Factura Lonja Veracruz #<%= compra.id_cmp %>', 'Factura oficial de compra lote #<%= compra.id_cmp %> por <%= dinero(compra.precio_total) %>')">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/></svg>
      <%= t('compartir') %>
    </button>

    <!-- Enviar por correo al comprador -->
    <% if (compra.comprador && compra.comprador.correo) { %>
      <form action="/compras/<%= compra.id_cmp %>/enviar-correo" method="POST" class="d-inline" onsubmit="return confirm('¿Enviar factura PDF a <%= compra.comprador.correo %>?')">
        <button class="btn btn-outline-primary" type="submit">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/></svg>
          <%= t('enviar_correo') %>
        </button>
      </form>
    <% } %>

    <button class="btn btn-outline-secondary" type="button" onclick="window.print()">Imprimir</button>
  </div>
</div>

<% if (typeof mensaje !== 'undefined' && mensaje) { %>
  <div class="alert alert-success alert-dismissible fade show d-print-none" role="alert">
    <%= mensaje %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show d-print-none" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- DOCUMENTO OFICIAL DE FACTURA -->
<div class="invoice-box">
  <!-- Encabezado de la Factura -->
  <div class="row align-items-center invoice-header gy-3">
    <div class="col-sm-7">
      <div class="d-flex align-items-center gap-2 mb-2">
        <img src="/img/logo.svg" alt="Lonja de Veracruz" style="max-height: 48px;">
      </div>
      <div class="small text-muted">
        <strong>LONJA PESQUERA DE VERACRUZ S.A. DE C.V.</strong><br>
        RFC: LPV-890412-M98 &bull; Régimen de Pesca y Subastas Marítimas<br>
        Muelle Fiscal de Pescadores S/N, Malecón del Puerto, C.P. 91700, Veracruz, Ver.<br>
        Tel: (229) 900-1234 &bull; contacto@lonjaveracruz.mx
      </div>
    </div>
    <div class="col-sm-5 text-sm-end">
      <div class="border rounded p-3 bg-light d-inline-block text-sm-end w-100">
        <span class="badge bg-primary text-uppercase mb-1">Factura Comercial</span>
        <div class="h4 fw-bold mb-0 text-primary">FAC-<%= String(compra.id_cmp).padStart(6, '0') %></div>
        <div class="small text-muted mt-1">
          <strong>Fecha de emisión:</strong><br>
          <%= fechaHora(compra.fecha) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Datos del Cliente -->
  <div class="row mb-4 gy-3">
    <div class="col-md-6">
      <div class="p-3 border rounded h-100 bg-light">
        <h6 class="fw-bold text-primary mb-2 text-uppercase small">Datos del Comprador</h6>
        <div class="fw-bold fs-6"><%= compra.comprador.nombre %> <%= compra.comprador.apellido_paterno %> <%= compra.comprador.apellido_materno || '' %></div>
        <div class="small text-muted mt-1">
          <strong>Código Cliente:</strong> #<%= compra.comprador.codigo_cpr %><br>
          <strong>Correo:</strong> <%= compra.comprador.correo || 'No registrado' %><br>
          <strong>Dirección:</strong> <%= compra.comprador.direccion || 'Veracruz, México' %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="p-3 border rounded h-100 bg-light">
        <h6 class="fw-bold text-primary mb-2 text-uppercase small">Condiciones Comerciales</h6>
        <div class="small text-muted">
          <strong>Método de Pago:</strong> PUE - Pago en una sola exhibición<br>
          <strong>Forma de Adjudicación:</strong> Subasta a viva voz en lonja<br>
          <strong>Moneda:</strong> <%= pref.moneda %><br>
          <strong>Lugar de Entrega:</strong> Muelle de Desembarque, Veracruz
        </div>
      </div>
    </div>
  </div>

  <!-- Detalle de la Compra -->
  <div class="table-responsive mb-4">
    <table class="table table-bordered align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Lote</th>
          <th>Especies y Descripción</th>
          <th class="text-end">Cajas</th>
          <th class="text-end">Kilos Netos</th>
          <th class="text-end">Salida/kg</th>
          <th class="text-end">Precio Adjudicado/kg</th>
          <th class="text-end">Importe Total</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="badge bg-secondary">#<%= compra.id_cmp %></span></td>
          <td>
            <strong>
              <%= compra.lote.especies.map(e => e.nombre + (e.tipo ? ' (' + e.tipo.nombre + ')' : '')).join(', ') || 'Pescado fresco del día' %>
            </strong>
            <div class="small text-muted">Captura ribereña certificada</div>
          </td>
          <td class="text-end"><%= compra.lote.numero_cajas %></td>
          <td class="text-end fw-semibold"><%= Number(compra.lote.kilos).toFixed(2) %> kg</td>
          <td class="text-end text-muted"><%= dinero(compra.lote.precio_kilo_salida) %></td>
          <td class="text-end fw-bold"><%= dinero(compra.precio_kilo_final) %></td>
          <td class="text-end fw-bold text-primary fs-6"><%= dinero(compra.precio_total) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Totales y Resumen -->
  <div class="row align-items-start mb-4">
    <div class="col-md-7 mb-3 mb-md-0">
      <div class="p-3 border rounded small text-muted bg-light">
        <strong>INFORMACIÓN FISCAL:</strong><br>
        Tasa IVA 0% de conformidad con el Art. 2o.-A Fracción I inciso b) de la Ley del Impuesto al Valor Agregado para productos pesqueros y del mar no procesados.<br>
        Este comprobante ampara la legítima procedencia y adquisición en subasta pesquera.
      </div>
    </div>
    <div class="col-md-5">
      <div class="border rounded p-3 bg-light">
        <div class="d-flex justify-content-between py-1">
          <span class="text-muted">Subtotal:</span>
          <span class="fw-semibold"><%= dinero(compra.precio_total) %></span>
        </div>
        <div class="d-flex justify-content-between py-1 border-bottom">
          <span class="text-muted">IVA (0%):</span>
          <span>$0.00</span>
        </div>
        <div class="d-flex justify-content-between pt-2">
          <span class="h5 fw-bold text-primary mb-0">TOTAL:</span>
          <span class="h5 fw-bold text-primary mb-0"><%= dinero(compra.precio_total) %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Sello y Cadena Digital -->
  <div class="border-top pt-3 small text-muted">
    <div class="fw-semibold">Cadena Digital de Autenticidad:</div>
    <code class="d-block small text-break text-muted py-1">
      ||1.1|FAC-<%= compra.id_cmp %>|<%= new Date(compra.fecha).toISOString() %>|<%= compra.precio_total %>|MXN|<%= compra.codigo_cpr %>|LPV890412M98||
    </code>
    <div class="text-center mt-3 text-secondary small">
      Lonja Pesquera de Veracruz &bull; Comprobante emitido electrónicamente &bull; Gracias por su preferencia
    </div>
  </div>
</div>

<%- include('../plantillas/footer') %>
