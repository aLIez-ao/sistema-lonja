<%- include('plantillas/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="h3 mb-1 fw-bold"><%= t('resumen_del_dia') %></h1>
    <p class="text-muted small mb-0">Fecha operativa del puerto: <span class="fw-semibold text-primary"><%= fecha %></span></p>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-primary" href="/compras/crear">
      <%- icono('plus-lg', 16, 'me-1') %>
      <%= t('registrar_compra') %>
    </a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="metric-card">
      <div class="metric-label"><%= t('compras_hoy') %></div>
      <div class="metric-value"><%= numCompras %></div>
      <div class="small text-muted mt-2">Transacciones formalizadas</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="metric-card">
      <div class="metric-label"><%= t('importe_hoy') %></div>
      <div class="metric-value text-primary"><%= dinero(total) %></div>
      <div class="small text-muted mt-2">Ingreso bruto en subasta</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="metric-card">
      <div class="metric-label"><%= t('lotes_libres') %></div>
      <div class="metric-value"><%= lotesLibres %></div>
      <div class="small text-muted mt-2">Disponibles en el muelle</div>
    </div>
  </div>
</div>

<div class="card p-4">
  <h5 class="fw-bold mb-3 text-primary">Acciones Rápidas del Día</h5>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/compras/crear">
      <%- icono('plus-lg', 16, 'me-1') %>
      <%= t('registrar_compra') %>
    </a>
    <a class="btn btn-outline-primary" href="/lotes/crear">
      <%- icono('plus-lg', 16, 'me-1') %>
      <%= t('registrar_lote') %>
    </a>
    <a class="btn btn-outline-secondary" href="/reportes/diario">
      <%- icono('bar-chart-line', 16, 'me-1') %>
      <%= t('ver_reporte_diario') %>
    </a>
  </div>
</div>

<%- include('plantillas/footer') %>
