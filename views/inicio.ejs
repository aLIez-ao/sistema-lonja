<%- include('plantillas/header') %>
<h1 class="h3 mb-4">Resumen del día (<%= fecha %>)</h1>
<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="display-6"><%= numCompras %></div><div class="text-muted">Compras de hoy</div></div></div></div>
  <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="display-6"><%= dinero(total) %></div><div class="text-muted">Importe de hoy</div></div></div></div>
  <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="display-6"><%= lotesLibres %></div><div class="text-muted">Lotes sin comprar</div></div></div></div>
</div>
<div class="d-flex flex-wrap gap-2">
  <a class="btn btn-primary" href="/compras/crear">Registrar compra</a>
  <a class="btn btn-outline-primary" href="/lotes/crear">Registrar lote</a>
  <a class="btn btn-outline-primary" href="/reportes/diario">Ver reporte diario</a>
</div>
<%- include('plantillas/footer') %>
