<%- include('../plantillas/header') %>
<main class="container py-4"><h1>Moderación de preguntas</h1><% preguntas.forEach((p) => { %><article class="card mb-3"><div class="card-body"><p><strong><%= p.autor?.nombre_completo %></strong> · <%= p.estado %></p><p><%= p.texto %></p><form action="/preguntas/<%= p.id_preg %>" method="post"><label for="r-<%= p.id_preg %>" class="form-label">Respuesta</label><textarea id="r-<%= p.id_preg %>" name="respuesta" maxlength="500" class="form-control" rows="2"><%= p.respuesta || '' %></textarea><button class="btn btn-primary mt-2">Responder</button><button class="btn btn-outline-danger mt-2" name="estado" value="oculta">Ocultar</button></form></div></article><% }) %></main><%- include('../plantillas/footer') %>
