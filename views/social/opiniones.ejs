<%- include('../plantillas/header') %>
<main class="container py-4"><h1>Moderación de opiniones</h1><% opiniones.forEach((o) => { %><article class="card mb-3"><div class="card-body"><p><strong><%= o.especie?.nombre %></strong> · <%= o.autor?.nombre_completo %> · <%= o.estrellas %>/5</p><h2 class="h5"><%= o.titulo %></h2><p><%= o.texto %></p><form action="/opiniones/<%= o.id_op %>" method="post"><input type="hidden" name="visible" value="<%= !o.visible %>"><button class="btn btn-outline-secondary"><%= o.visible ? 'Ocultar' : 'Publicar' %></button></form></div></article><% }) %></main><%- include('../plantillas/footer') %>
