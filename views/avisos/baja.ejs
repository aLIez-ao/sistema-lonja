<%- include('../plantillas/header') %>
<main class="container py-5">
  <div class="card mx-auto p-4" style="max-width: 38rem;">
    <h1 class="h4 fw-bold">Confirmar baja de avisos</h1>
    <p class="text-muted">Al confirmar, dejarás de recibir correos sobre subastas y novedades. Los avisos de seguridad y de tus pedidos no cambian.</p>
    <form action="/avisos/baja/<%= encodeURIComponent(token) %>" method="post">
      <button class="btn btn-primary" type="submit">Confirmar baja</button>
      <a class="btn btn-outline-secondary" href="/">Cancelar</a>
    </form>
  </div>
</main>
<%- include('../plantillas/footer') %>
