<%- include('../plantillas/header') %>
<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
  <div><p class="text-uppercase small text-muted fw-semibold mb-1">Tienda de la lonja</p><h1 class="h2 mb-0">Tu carrito</h1></div>
  <a class="btn btn-outline-primary" href="/">Seguir explorando</a>
</div>
<%- include('../plantillas/mensajes', { mensaje, errores: error ? [error] : [] }) %>

<% if (!items.length) { %>
  <div class="card p-5 text-center"><h2 class="h5">Todavía no agregas lotes</h2><p class="text-muted">Explora la tienda para ver lo disponible hoy.</p><a class="btn btn-primary mx-auto" href="/">Ver lotes</a></div>
<% } else { %>
  <div class="row g-4 align-items-start">
    <div class="col-lg-8">
      <div class="d-flex flex-column gap-3">
        <% items.forEach((item) => { %>
          <article class="card p-3">
            <div class="d-flex gap-3 align-items-center">
              <% if (item.lote) { %><img src="<%= item.lote.imagen %>" alt="" width="112" height="84" class="rounded object-fit-cover"><% } %>
              <div class="flex-grow-1 min-w-0">
                <h2 class="h6 mb-1"><% if (item.lote) { %><a href="/tienda/lote/<%= item.id_lte %>">Lote #<%= item.id_lte %> · <%= item.lote.nombresEspecies %></a><% } else { %>Lote #<%= item.id_lte %><% } %></h2>
                <% if (item.problema) { %><p class="small text-danger mb-1"><%= item.problema %></p><% } %>
                <% if (item.lote) { %><p class="small text-muted mb-1"><%= Number(item.lote.kilos).toFixed(2) %> kg · <%= item.lote.numero_cajas %> cajas</p><p class="mb-0 fw-semibold"><%= dinero(item.lote.total) %> MXN</p><% } %>
              </div>
              <form action="/carrito/quitar/<%= item.id_lte %>" method="POST" data-carrito-accion>
                <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Quitar lote <%= item.id_lte %>">Quitar</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
      <form action="/carrito/vaciar" method="POST" class="mt-3" data-carrito-accion><button class="btn btn-sm btn-link text-danger" type="submit">Vaciar carrito</button></form>
    </div>
    <aside class="col-lg-4">
      <div class="card p-4 position-sticky" style="top:1rem">
        <h2 class="h5">Resumen</h2><div class="d-flex justify-content-between border-top pt-3"><span>Subtotal de lotes disponibles</span><strong><%= dinero(subtotal) %></strong></div>
        <p class="small text-muted mt-2">El envío se calcula al elegir entrega. El servidor volverá a confirmar precio y disponibilidad.</p>
        <% if (subtotal > 0) { %><a class="btn btn-primary w-100" href="/pedido/nuevo">Continuar al pedido</a><% } else { %><button class="btn btn-primary w-100" disabled>Sin lotes disponibles</button><% } %>
      </div>
    </aside>
  </div>
<% } %>
<div class="tienda-toasts" aria-live="polite" aria-atomic="true" data-toasts></div>
<%- include('../plantillas/footer') %>
