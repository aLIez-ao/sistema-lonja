<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('lotes') %></h1>
    <p class="text-muted small mb-0">Gestión de lotes capturados y su estado en subasta</p>
  </div>
  <a class="btn btn-primary" href="/lotes/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    <%= t('registrar_lote') %>
  </a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0 table-sortable">
      <thead>
        <tr>
          <th>Lote</th>
          <th>Fecha</th>
          <th>Especies</th>
          <th class="text-end">Cajas</th>
          <th class="text-end">Kilos</th>
          <th class="text-end">Precio salida/kg</th>
          <th>Estado</th>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% lotes.forEach(l => { %>
        <tr>
          <td><span class="badge bg-secondary">#<%= l.id_lte %></span></td>
          <td data-sort-value="<%= new Date(l.fecha).getTime() %>"><%= fechaHora(l.fecha) %></td>
          <td>
            <strong><%= l.especies.map(e => e.nombre + ' (' + e.tipo.nombre + ')').join(', ') || '—' %></strong>
            <a class="small text-decoration-none ms-1" href="/especies/crear?lote=<%= l.id_lte %>">+ especie</a>
          </td>
          <td class="text-end"><%= l.numero_cajas %></td>
          <td class="text-end"><%= Number(l.kilos).toFixed(2) %> kg</td>
          <td class="text-end text-muted"><%= dinero(l.precio_kilo_salida) %></td>
          <td>
            <% if (l.compra) { %>
              <span class="badge bg-success">Comprado por <%= l.compra.comprador.nombre %> <%= l.compra.comprador.apellido_paterno %></span>
            <% } else { %>
              <span class="badge bg-warning text-dark">Disponible</span>
            <% } %>
          </td>
          <td class="text-end text-nowrap">
            <% if (!l.compra) { %>
              <!-- Vender Lote -->
              <a class="btn btn-sm btn-outline-primary" href="/compras/crear?lote=<%= l.id_lte %>" title="Registrar compra de este lote">
                <%- icono('cart-plus', 14) %>
              </a>
              <!-- Editar Lote -->
              <a class="btn btn-sm btn-outline-secondary" href="/lotes/<%= l.id_lte %>/editar" title="Editar lote">
                <%- icono('pencil', 14) %>
              </a>
            <% } %>
            <% if (usuario.rol === 'admin' && !l.compra) { %>
              <form action="/lotes/<%= l.id_lte %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este lote y sus especies?')">
                <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar lote" aria-label="Eliminar lote">
                  <%- icono('trash', 14) %>
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../plantillas/footer') %>
