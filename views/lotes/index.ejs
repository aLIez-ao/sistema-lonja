<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('lotes') %></h1>
    <p class="text-muted small mb-0">Gestión de lotes capturados y su estado en subasta</p>
  </div>
  <a class="btn btn-primary" href="/lotes/crear">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
    <%= t('registrar_lote') %>
  </a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0 table-sortable">
      <thead>
        <tr>
          <th>Lote</th>
          <th>Fecha</th>
          <th>Especies</th>
          <th class="text-end">Cajas</th>
          <th class="text-end">Kilos</th>
          <th class="text-end">Precio salida/kg</th>
          <th>Estado</th>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% lotes.forEach(l => { %>
        <tr>
          <td><span class="badge bg-secondary">#<%= l.id_lte %></span></td>
          <td><%= fechaHora(l.fecha) %></td>
          <td>
            <strong><%= l.especies.map(e => e.nombre + ' (' + e.tipo.nombre + ')').join(', ') || '—' %></strong>
            <a class="small text-decoration-none ms-1" href="/especies/crear?lote=<%= l.id_lte %>">+ especie</a>
          </td>
          <td class="text-end"><%= l.numero_cajas %></td>
          <td class="text-end"><%= Number(l.kilos).toFixed(2) %> kg</td>
          <td class="text-end text-muted"><%= dinero(l.precio_kilo_salida) %></td>
          <td>
            <% if (l.compra) { %>
              <span class="badge bg-success">Comprado por <%= l.compra.comprador.nombre %> <%= l.compra.comprador.apellido_paterno %></span>
            <% } else { %>
              <span class="badge bg-warning text-dark">Disponible</span>
            <% } %>
          </td>
          <td class="text-end text-nowrap">
            <% if (!l.compra) { %>
              <!-- Vender Lote -->
              <a class="btn btn-sm btn-success" href="/compras/crear?lote=<%= l.id_lte %>" title="Vender en subasta">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/></svg>
              </a>
              <!-- Editar Lote -->
              <a class="btn btn-sm btn-outline-secondary" href="/lotes/<%= l.id_lte %>/editar" title="Editar lote">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/></svg>
              </a>
            <% } %>
            <% if (usuario.rol === 'admin' && !l.compra) { %>
              <form action="/lotes/<%= l.id_lte %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este lote y sus especies?')">
                <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar lote">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg>
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../plantillas/footer') %>
