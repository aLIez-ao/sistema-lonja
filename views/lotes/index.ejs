<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('lotes') %></h1>
    <p class="text-muted small mb-0">Gestión de lotes capturados y su estado en subasta</p>
  </div>
  <a class="btn btn-primary" href="/lotes/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    <%= t('registrar_lote') %>
  </a>
</div>
<%- include('../plantillas/mensajes', { errores: (typeof error !== 'undefined' && error) ? [error] : [] }) %>
<%- include('../plantillas/barra-listado', { l, entidad: 'lotes', etiqueta: 'lotes' }) %>
<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0" data-orden-servidor>
      <thead>
        <tr>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'id', titulo: 'Lote' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'fecha', titulo: 'Fecha' }) %>
          <th>Especies</th>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'cajas', titulo: 'Cajas', claseExtra: 'text-end' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'kilos', titulo: 'Kilos', claseExtra: 'text-end' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'salida', titulo: 'Precio salida/kg', claseExtra: 'text-end' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'estado', titulo: 'Estado' }) %>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% if (!lotes.length) { %>
        <tr class="fila-vacia">
          <td colspan="8" class="text-center py-4 text-muted">
            <%= (l.q || Object.keys(l.filtros).length) ? 'No hay registros que coincidan con la búsqueda.' : 'No hay lotes registrados en el sistema.' %>
          </td>
        </tr>
      <% } %>
      <% lotes.forEach(lote => { %>
        <tr>
          <td><span class="badge bg-secondary">#<%= lote.id_lte %></span></td>
          <td data-sort-value="<%= new Date(lote.fecha).getTime() %>"><%= fechaHora(lote.fecha) %></td>
          <td>
            <% (lote.especies || []).forEach((e, i) => { %>
              <a class="enlace-registro" href="/especies/<%= e.id_epe %>"><%= e.nombre %> (<%= e.tipo.nombre %>)</a><%= i < lote.especies.length - 1 ? ', ' : '' %>
            <% }) %>
            <% if (!(lote.especies || []).length) { %>—<% } %>
            <a class="small text-decoration-none ms-1" href="/especies/crear?lote=<%= lote.id_lte %>">+ especie</a>
          </td>
          <td class="text-end"><%= lote.numero_cajas %></td>
          <td class="text-end"><%= Number(lote.kilos).toFixed(2) %> kg</td>
          <td class="text-end text-muted"><%= dinero(lote.precio_kilo_salida) %></td>
          <td>
            <% if (lote.compra) { %>
              <span class="badge bg-success"><%- icono('lock', 12, 'me-1') %>Vendido</span>
              <a class="enlace-registro small ms-1" href="/compradores/<%= lote.compra.comprador.codigo_cpr %>">a <%= lote.compra.comprador.nombre %> <%= lote.compra.comprador.apellido_paterno %></a>
              <a class="enlace-registro small ms-1" href="/compras/<%= lote.compra.id_cmp %>/factura">#<%= lote.compra.id_cmp %></a>
            <% } else { %>
              <span class="badge bg-warning text-dark">Disponible</span>
            <% } %>
          </td>
          <td class="text-end text-nowrap">
            <% if (!lote.compra) { %>
              <!-- Vender Lote -->
              <a class="btn btn-sm btn-outline-primary" href="/compras/crear?lote=<%= lote.id_lte %>" title="Registrar compra de este lote" aria-label="Registrar compra de este lote">
                <%- icono('cart-plus', 14) %>
              </a>
              <!-- Editar Lote -->
              <a class="btn btn-sm btn-outline-secondary" href="/lotes/<%= lote.id_lte %>/editar" title="Editar lote" aria-label="Editar lote">
                <%- icono('pencil', 14) %>
              </a>
            <% } %>
            <% if (usuario.rol === 'admin' && !lote.compra) { %>
              <form action="/lotes/<%= lote.id_lte %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este lote y sus especies?')">
                <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar lote" aria-label="Eliminar lote">
                  <%- icono('trash', 14) %>
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../plantillas/paginacion', { l, etiqueta: 'lotes' }) %>
<%- include('../plantillas/footer') %>
