<%- include('../plantillas/header') %>
<h1 class="h3 mb-3"><%= lote && lote.id_lte ? 'Editar lote ' + lote.id_lte : 'Nuevo lote' %></h1>
<%- include('../plantillas/mensajes', { mensaje: null }) %>
<form action="<%= action %>" method="POST" class="col-lg-6">
  <div class="mb-3"><label class="form-label" for="kilos">Kilos</label>
    <input class="form-control" type="number" step="0.01" min="0.01" id="kilos" name="kilos" value="<%= lote ? lote.kilos : '' %>" required></div>
  <div class="mb-3"><label class="form-label" for="numero_cajas">Número de cajas</label>
    <input class="form-control" type="number" step="1" min="0" max="32767" id="numero_cajas" name="numero_cajas" value="<%= lote ? lote.numero_cajas : '' %>" required></div>
  <div class="mb-3"><label class="form-label" for="precio_kilo_salida">Precio de salida por kilo (MXN)</label>
    <input class="form-control" type="number" step="0.01" min="0" id="precio_kilo_salida" name="precio_kilo_salida" value="<%= lote ? lote.precio_kilo_salida : '' %>" required></div>
  <p class="text-muted small">La fecha y hora del lote se registran automáticamente.</p>
  <button class="btn btn-primary" type="submit">Guardar</button>
  <a class="btn btn-link" href="/lotes">Cancelar</a>
</form>
<%- include('../plantillas/footer') %>
