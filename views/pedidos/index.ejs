<%- include('../plantillas/header') %>
<main class="container-fluid px-lg-4 py-4"><% const paginaUrl = (n) => '/pedidos?' + new URLSearchParams({...filtros, pagina: String(n)}).toString(); %><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1>Pedidos en línea</h1><p class="text-muted mb-0">Seguimiento de reservas, pagos y entregas.</p></div></div>
<form class="row g-2 mb-3"><div class="col-md-4"><label class="visually-hidden" for="busqueda-pedido">Buscar pedido</label><input id="busqueda-pedido" class="form-control" name="q" value="<%= filtros.q || '' %>" placeholder="Número, comprador o correo"></div><div class="col-md-2"><label class="visually-hidden" for="estado-pedido">Estado</label><select id="estado-pedido" name="estado" class="form-select"><option value="">Todos los estados</option><% estados.forEach(e => { %><option value="<%= e %>" <%= filtros.estado === e ? 'selected' : '' %>><%= e.replace('_',' ') %></option><% }) %></select></div><div class="col-md-2"><select name="entrega" class="form-select"><option value="">Toda entrega</option><option value="domicilio" <%= filtros.entrega === 'domicilio' ? 'selected' : '' %>>Domicilio</option><option value="recoger" <%= filtros.entrega === 'recoger' ? 'selected' : '' %>>Recoger</option></select></div><div class="col-md-2"><input aria-label="Desde" type="date" class="form-control" name="desde" value="<%= filtros.desde || '' %>"></div><div class="col-md-2"><input aria-label="Hasta" type="date" class="form-control" name="hasta" value="<%= filtros.hasta || '' %>"></div><div class="col-md-2"><select name="orden" class="form-select"><option value="fecha">Fecha</option><option value="total" <%= filtros.orden === 'total' ? 'selected' : '' %>>Total</option><option value="estado" <%= filtros.orden === 'estado' ? 'selected' : '' %>>Estado</option></select></div><div class="col-md-2"><select name="dir" class="form-select"><option value="DESC" <%= filtros.dir !== 'ASC' ? 'selected' : '' %>>Descendente</option><option value="ASC" <%= filtros.dir === 'ASC' ? 'selected' : '' %>>Ascendente</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtrar</button></div></form>
<div class="table-responsive card"><table class="table table-hover align-middle mb-0"><thead><tr><th>Pedido</th><th>Fecha</th><th>Comprador</th><th>Estado</th><th>Entrega</th><th class="text-end">Total</th><th></th></tr></thead><tbody><% if (!pedidos.length) { %><tr><td colspan="7" class="text-center text-muted p-4">No hay pedidos con estos filtros.</td></tr><% } %><% pedidos.forEach(p => { %><tr><td>#<%= p.id_ped %></td><td><%= fechaHora(p.fecha) %></td><td><%= p.comprador.nombre %> <%= p.comprador.apellido_paterno %><small class="d-block text-muted"><%= p.usuario?.correo || p.comprador.correo %></small></td><td><span class="badge text-bg-secondary"><%= p.estado.replace('_',' ') %></span></td><td><%= p.entrega === 'domicilio' ? 'Domicilio' : 'Recoger' %></td><td class="text-end"><%= dinero(p.total) %></td><td><a class="btn btn-sm btn-outline-primary" href="/pedidos/<%= p.id_ped %>">Ver</a></td></tr><% }) %></tbody></table></div><nav class="mt-3 d-flex justify-content-between"><span class="text-muted">Página <%= pagina %> de <%= paginas %> · <%= total %> pedidos</span><div><% if (pagina > 1) { %><a class="btn btn-sm btn-outline-secondary" href="<%= paginaUrl(pagina - 1) %>">Anterior</a><% } %> <% if (pagina < paginas) { %><a class="btn btn-sm btn-outline-secondary" href="<%= paginaUrl(pagina + 1) %>">Siguiente</a><% } %></div></nav></main><%- include('../plantillas/footer') %>
