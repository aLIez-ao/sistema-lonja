<%- include('../plantillas/header') %>
<main class="container py-4"><a href="/pedidos">← Pedidos</a><div class="d-flex justify-content-between align-items-start flex-wrap mt-3"><div><h1>Pedido #<%= pedido.id_ped %></h1><p class="text-muted"><%= fechaHora(pedido.fecha) %> · <%= pedido.estado.replace('_',' ') %></p></div><% if (siguiente) { %><form method="post" action="/pedidos/<%= pedido.id_ped %>/estado"><input type="hidden" name="estado" value="<%= siguiente %>"><button class="btn btn-primary">Marcar como <%= siguiente.replace('_',' ') %></button></form><% } %></div>
<% if (mensaje) { %><div class="alert alert-success">Estado actualizado.</div><% } %><% if (error) { %><div class="alert alert-warning">La transición de estado no está permitida.</div><% } %>
<div class="row g-3"><section class="col-lg-7"><div class="card mb-3"><div class="card-body"><h2 class="h5">Artículos</h2><% pedido.items.forEach(i => { %><div class="d-flex justify-content-between border-bottom py-2"><span><a href="/lotes/<%= i.id_lte %>">Lote #<%= i.id_lte %></a> · <%= i.kilos %> kg<small class="d-block text-muted"><%= (i.lote?.especies || []).map(e => e.nombre).join(', ') %></small></span><strong><%= dinero(i.subtotal) %></strong></div><% }) %><div class="text-end mt-3">Subtotal <%= dinero(pedido.subtotal) %> · Envío <%= dinero(pedido.costo_envio) %><div class="h5">Total <%= dinero(pedido.total) %></div></div></div></div><div class="card"><div class="card-body"><h2 class="h5">Entrega</h2><p><%= pedido.entrega === 'domicilio' ? pedido.dir_destinatario : 'Recoger en la lonja' %></p><pre class="mb-0"><%= pedido.dir_texto || 'Muelle Fiscal de Veracruz' %></pre></div></div></section>
<aside class="col-lg-5"><div class="card mb-3"><div class="card-body"><h2 class="h5">Comprador</h2><p><%= pedido.comprador.nombre %> <%= pedido.comprador.apellido_paterno %><br><%= pedido.usuario?.correo || pedido.comprador.correo %></p><a href="/compradores/<%= pedido.codigo_cpr %>">Ficha del comprador</a></div></div><div class="card"><div class="card-body"><h2 class="h5">Pago</h2><p>Método: <%= pedido.pago_metodo || 'Pendiente' %><br>Referencia: <%= pedido.pago_ref || '—' %><br>Tarjeta: <%= pedido.pago_ultimos4 ? `•••• ${pedido.pago_ultimos4}` : '—' %></p><% compras.forEach(c => { %><a class="d-block" href="/compras/<%= c.id_cmp %>/factura">Factura del lote #<%= c.id_cmp %></a><% }) %></div></div></aside></div></main><%- include('../plantillas/footer') %>
