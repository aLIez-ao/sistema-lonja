<%- include('../plantillas/header') %>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card p-4">
      <h1 class="h3 mb-1 fw-bold"><%= item && item.id_cat ? 'Editar especie del catálogo' : 'Nueva especie del catálogo' %></h1>
      <p class="text-muted small mb-4">El nombre y el tipo se copian al registrar la especie en un lote; los lotes ya capturados no cambian si editas el catálogo.</p>

      <%- include('../plantillas/mensajes') %>

      <form action="<%= action %>" method="POST" data-validar novalidate>
        <div class="mb-3">
          <label class="form-label fw-semibold" for="nombre">Nombre</label>
          <input class="form-control" id="nombre" name="nombre" maxlength="40" value="<%= item ? (item.nombre || '') : '' %>" required autofocus>
          <div class="form-text">Ejemplo: Huachinango, Camarón, Jaiba.</div>
        </div>

        <div class="mb-3">
          <span class="form-label fw-semibold d-block">Tipo</span>
          <div class="segmentado" role="radiogroup" aria-label="Tipo de especie">
            <% tipos.forEach(tp => { %>
              <label class="segmentado-opcion">
                <input type="radio" name="id_tpo" value="<%= tp.id_tpo %>" <%= item && String(item.id_tpo) === String(tp.id_tpo) ? 'checked' : (tipos.length === 1 ? 'checked' : '') %> required>
                <span><%= tp.nombre %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold" for="descripcion">Descripción <span class="text-muted fw-normal">(opcional)</span></label>
          <textarea class="form-control" id="descripcion" name="descripcion" maxlength="300" rows="3"><%= item ? (item.descripcion || '') : '' %></textarea>
          <div class="form-text">Se muestra en la ficha de la especie en la tienda.</div>
        </div>

        <div class="mb-4">
          <span class="form-label fw-semibold d-block">Imagen <span class="text-muted fw-normal">(opcional)</span></span>
          <div class="campo-imagen d-flex align-items-center gap-3" data-campo-imagen>
            <div class="vista-imagen" data-imagen-vista>
              <% if (item && item.imagen) { %>
                <img src="<%= item.imagen %>" alt="Imagen actual de <%= item.nombre %>">
              <% } else { %>
                <span class="text-muted small">Sin imagen</span>
              <% } %>
            </div>
            <div class="flex-grow-1">
              <input class="form-control form-control-sm" type="file" accept="image/jpeg,image/png,image/webp" data-imagen-archivo aria-label="Subir imagen de la especie">
              <input type="hidden" name="imagen_data" data-imagen-data>
              <div class="form-text">JPG, PNG o WebP; se reduce automáticamente.</div>
              <% if (item && item.imagen) { %>
                <div class="form-check mt-1">
                  <input class="form-check-input" type="checkbox" name="imagen_quitar" id="imagenQuitar">
                  <label class="form-check-label small" for="imagenQuitar">Quitar la imagen actual</label>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-primary" type="submit"><%= item && item.id_cat ? 'Guardar cambios' : 'Agregar al catálogo' %></button>
          <a class="btn btn-outline-secondary" href="/catalogo">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../plantillas/footer') %>
