<%- include('../plantillas/header') %>
<main class="container py-4"><h1><%= lista.nombre %></h1><form action="/cuenta/listas/<%= lista.id_lista %>?_method=PUT" method="post" class="d-flex gap-2 mb-3"><label class="visually-hidden" for="renombrar">Cambiar nombre</label><input id="renombrar" name="nombre" maxlength="40" class="form-control" value="<%= lista.nombre %>" required><button class="btn btn-outline-secondary">Renombrar</button></form>
<form action="/cuenta/listas/<%= lista.id_lista %>?_method=DELETE" method="post" class="mb-4"><button class="btn btn-outline-danger">Eliminar lista</button></form>
<div class="list-group"><% items.forEach(({tipo,elemento,vendido}) => { %><div class="list-group-item d-flex justify-content-between align-items-center"><span><%= tipo === 'lote' ? `Lote #${elemento.id_lte}${vendido ? ' · Vendido' : ''}` : elemento.nombre %></span><form action="/cuenta/listas/<%= lista.id_lista %>/items?_method=DELETE" method="post"><input type="hidden" name="tipo" value="<%= tipo %>"><input type="hidden" name="id_ref" value="<%= tipo === 'lote' ? elemento.id_lte : elemento.id_cat %>"><button class="btn btn-sm btn-outline-secondary">Quitar</button></form></div><% }) %></div></main><%- include('../plantillas/footer') %>
