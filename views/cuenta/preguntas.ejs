<%- include('../plantillas/header') %>
<main class="container py-4"><h1>Mis preguntas</h1><% if (!preguntas.length) { %><p class="text-muted">Todavía no has enviado preguntas.</p><% } %><% preguntas.forEach((p) => { %><article class="card mb-3"><div class="card-body"><p><%= p.texto %></p><span class="badge bg-secondary"><%= p.estado %></span><% if (p.respuesta) { %><p class="mt-3 mb-0"><strong>Respuesta:</strong> <%= p.respuesta %></p><% } %></div></article><% }) %></main><%- include('../plantillas/footer') %>
