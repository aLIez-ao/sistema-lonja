<%- include('../plantillas/header') %>
<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
  <div><a href="/cuenta" class="small">← Mi cuenta</a><h1 class="h2 mb-0 mt-1">Mis pedidos</h1></div>
  <a class="btn btn-outline-primary" href="/">Explorar la tienda</a>
</div>
<%- include('../plantillas/mensajes', { mensaje, errores: error ? [error] : [] }) %>
<% if (!pedidos.length) { %><div class="card p-5 text-center"><p class="text-muted mb-3">Aún no tienes pedidos en línea.</p><a class="btn btn-primary mx-auto" href="/">Explorar lotes</a></div><% } else { %>
  <div class="table-responsive card p-3"><table class="table align-middle mb-0">
    <thead><tr><th>Pedido</th><th>Fecha</th><th>Entrega</th><th>Estado</th><th class="text-end">Total</th><th></th></tr></thead>
    <tbody><% pedidos.forEach((p) => { %><tr>
      <td><strong>#<%= p.id_ped %></strong><div class="small text-muted"><%= p.items.length %> lote(s)</div></td>
      <td><%= fechaHora(p.fecha) %></td><td><%= p.entrega === 'domicilio' ? 'Domicilio' : 'Recoger' %></td>
      <td><span class="badge text-bg-<%= p.estado === 'pagado' || p.estado === 'entregado' ? 'success' : p.estado === 'pendiente_pago' ? 'warning' : 'secondary' %>"><%= p.estado.replaceAll('_', ' ') %></span></td>
      <td class="text-end fw-semibold"><%= dinero(p.total) %></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/cuenta/pedidos/<%= p.id_ped %>">Ver pedido</a></td>
    </tr><% }) %></tbody>
  </table></div>
<% } %>
<%- include('../plantillas/footer') %>
