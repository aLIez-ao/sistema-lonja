<%# Selector de foto de perfil. El navegador la recorta a 256x256 (public/js/lonja-app.js) y la envía en foto_data. Parámetro: u %>
<div class="campo-foto d-flex align-items-center gap-3" data-campo-foto>
  <div data-foto-vista><%- include('avatar', { u: u || {}, clase: 'avatar-lg' }) %></div>
  <div>
    <label class="form-label fw-semibold mb-1" for="fotoArchivo">Foto de perfil <span class="text-muted fw-normal">(opcional)</span></label>
    <input class="form-control form-control-sm" type="file" id="fotoArchivo" accept="image/jpeg,image/png,image/webp" data-foto-archivo>
    <input type="hidden" name="foto_data" data-foto-data>
    <div class="form-text">JPG, PNG o WebP. Se recorta al centro en forma cuadrada.</div>
    <% if (u && u.foto) { %>
      <div class="form-check mt-1">
        <input class="form-check-input" type="checkbox" name="foto_quitar" id="fotoQuitar">
        <label class="form-check-label small" for="fotoQuitar">Quitar la foto actual y usar mis iniciales</label>
      </div>
    <% } %>
  </div>
</div>
