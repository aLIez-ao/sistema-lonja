<%# Campo de contraseña nueva con requisitos y confirmación. Parámetros: nombre, etiqueta, requerido %>
<div class="mb-3">
  <label class="form-label fw-semibold" for="<%= nombre %>"><%= etiqueta %></label>
  <div class="input-group">
    <input class="form-control" type="password" id="<%= nombre %>" name="<%= nombre %>" minlength="8" maxlength="72" autocomplete="new-password" data-password-nueva <%= requerido ? 'required' : '' %>>
    <button class="btn btn-outline-secondary" type="button" data-ver-password="<%= nombre %>" aria-label="Mostrar u ocultar la contraseña"><%- icono('eye') %></button>
  </div>
  <ul class="requisitos-password small mt-2 mb-0" data-requisitos-de="<%= nombre %>">
    <li data-regla="largo">Entre 8 y 72 caracteres</li>
    <li data-regla="letra">Al menos una letra</li>
    <li data-regla="numero">Al menos un número</li>
  </ul>
</div>
<div class="mb-3">
  <label class="form-label fw-semibold" for="password_confirmar">Confirmar contraseña</label>
  <input class="form-control" type="password" id="password_confirmar" name="password_confirmar" minlength="8" maxlength="72" autocomplete="new-password" data-confirma="<%= nombre %>" <%= requerido ? 'required' : '' %>>
  <div class="invalid-feedback">Las contraseñas no coinciden.</div>
</div>
