<%
  // Avatar de un usuario: su foto si tiene, o un círculo con las iniciales de nombre y apellido.
  // Parámetros: u (usuario), clase (opcional, p. ej. 'avatar-lg' o 'avatar-sm')
  const _nombre = ((u && (u.nombre_completo || u.usuario)) || '').trim();
  const _partes = _nombre.split(/\s+/).filter(Boolean);
  const _iniciales = (_partes.length >= 2 ? _partes[0][0] + _partes[1][0] : (_partes[0] || 'U').substring(0, 2)).toUpperCase();
  const _clase = typeof clase !== 'undefined' ? clase : '';
%><% if (u && u.foto) { %><img class="avatar-usuario <%= _clase %>" src="<%= u.foto %>" alt="Foto de <%= _nombre %>"><% } else { %><span class="avatar-usuario <%= _clase %>" aria-hidden="true"><%= _iniciales %></span><% } %>
