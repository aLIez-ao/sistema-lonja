<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="img/favicon.svg" type="image/x-icon">
  <title>Sistema Lonja</title>
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <!-- TODO: Esta cargando el css? -->
  <link rel="stylesheet" href="/css/lonja.css">
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary d-print-none">
    <div class="container-fluid">
      <a class="navbar-brand" href="/inicio">
        <!-- TODO: no se ve la imagen -->
        <img src="/img/logo.svg" alt="Lonja de Veracruz" style="max-height: 50px; width: auto;"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
        <span style="display: none;" class="fw-bold">Lonja de Veracruz</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu"
        aria-expanded="false" aria-label="Menú">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <% if (usuario) { %>
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item"><a class="nav-link" href="/compras">Compras</a></li>
            <li class="nav-item"><a class="nav-link" href="/lotes">Lotes</a></li>
            <li class="nav-item"><a class="nav-link" href="/especies">Especies</a></li>
            <li class="nav-item"><a class="nav-link" href="/compradores">Compradores</a></li>
            <li class="nav-item"><a class="nav-link" href="/tipos">Tipos</a></li>
            <li class="nav-item"><a class="nav-link" href="/reportes/diario">Reporte diario</a></li>
            <% if (usuario.rol==='admin' ) { %>
              <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios</a></li>
              <% } %>
          </ul>
          <span class="navbar-text me-3">
            <%= usuario.nombre_completo %> (<%= usuario.rol %>)
          </span>
          <a class="btn btn-outline-light btn-sm" href="/cerrarsesion">Cerrar sesión</a>
          <% } %>
      </div>
    </div>
  </nav>
  <main class="container py-4">