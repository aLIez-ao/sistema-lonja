<%
  // Barra de búsqueda común de los listados.
  // Uso: include con { l, entidad, etiqueta }.
  const textoEtiqueta = typeof etiqueta !== 'undefined' ? etiqueta : entidad;
%>
<form method="GET" action="<%= l.ruta %>" class="barra-listado mb-3" role="search" data-buscador>
  <% Object.entries(l.params).forEach(([clave, valor]) => { %>
    <% if (clave !== 'q') { %>
      <input type="hidden" name="<%= clave %>" value="<%= valor %>">
    <% } %>
  <% }) %>

  <div class="buscador position-relative flex-grow-1">
    <input
      type="search"
      name="q"
      value="<%= l.q %>"
      class="form-control form-control-sm"
      placeholder="Buscar en <%= textoEtiqueta %>…"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls="sugerencias-<%= entidad %>"
      aria-label="Buscar en <%= textoEtiqueta %>"
      data-entidad="<%= entidad %>"
    >
    <ul id="sugerencias-<%= entidad %>" class="list-group lista-sugerencias shadow-sm" role="listbox" hidden></ul>
  </div>

  <button class="btn btn-sm btn-primary" type="submit">
    <%- icono('search', 14, 'me-1') %>Buscar
  </button>

  <% if (l.q) { %>
    <a class="btn btn-sm btn-outline-secondary" href="<%= l.urlCon({ q: null, pagina: 1 }) %>" aria-label="Limpiar búsqueda" title="Limpiar búsqueda">
      <%- icono('x-lg', 14) %>
    </a>
  <% } %>
</form>
