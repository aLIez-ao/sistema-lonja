  </main>

  <footer class="container text-center text-muted py-4 mt-auto d-print-none">
    <div class="row align-items-center gy-2">
      <div class="col-12">
        <small class="fw-semibold text-secondary">Sistema Lonja de Veracruz &bull; Web 2 &bull; FES Aragón, UNAM</small>
        <div class="small text-muted">Hector Ardan Montiel Olvera &bull; Jesus Armando Serrano Medina &bull; Mendoza Lemus Leonardo</div>
      </div>
    </div>
  </footer>

  <!-- Banner de Consentimiento de Cookies (solo cuando el usuario haya iniciado sesión) -->
  <% if (usuario && !pref.cookiesRespondidas) { %>
    <div id="cookieConsentBanner" class="cookie-consent-bar d-print-none">
      <div class="d-flex align-items-start gap-3">
        <div class="text-primary fs-3">🍪</div>
        <div class="flex-grow-1">
          <h6 class="fw-bold mb-1"><%= t('cookies_banner_titulo') %></h6>
          <p class="small text-muted mb-2"><%= t('cookies_banner_desc') %></p>
          
          <!-- Acordeón interactivo para ver qué hace cada cookie -->
          <div class="collapse" id="collapseCookieDetalles">
            <div class="border rounded p-2 mb-2 bg-light small">
              <div class="fw-semibold text-dark mb-1">¿Qué cookies utilizamos?</div>
              <ul class="list-unstyled mb-0 text-muted" style="font-size: 0.8rem;">
                <li><strong>_token</strong> (Esencial): Mantiene tu sesión segura y protegida contra CSRF.</li>
                <li><strong>lonja_theme</strong> (Personalización): Guarda el tema visual (Océano, Claro, Oscuro).</li>
                <li><strong>lonja_currency</strong> (Funcional): Guarda tu moneda seleccionada (MXN, USD, EUR).</li>
                <li><strong>lonja_lang</strong> (Personalización): Guarda tu preferencia de idioma (Español, English).</li>
                <li><strong>lonja_font_size / lonja_font_family</strong> (Accesibilidad): Ajustes de tamaño y tipografía.</li>
              </ul>
            </div>
          </div>

          <a class="small text-decoration-none fw-semibold" data-bs-toggle="collapse" href="#collapseCookieDetalles" role="button" aria-expanded="false" aria-controls="collapseCookieDetalles">
            Ver qué hace cada cookie &darr;
          </a>
        </div>
      </div>
      <div class="d-flex gap-2 justify-content-end flex-wrap mt-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="aceptarCookies('essential')"><%= t('cookies_esenciales') %></button>
        <button type="button" class="btn btn-sm btn-primary" onclick="aceptarCookies('all')"><%= t('cookies_aceptar') %></button>
      </div>
    </div>
  <% } %>

  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/lonja-app.js"></script>
</body>
</html>
