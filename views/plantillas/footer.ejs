  </main>

  <footer class="container text-center text-muted py-4 mt-auto d-print-none">
    <div class="row align-items-center gy-2">
      <div class="col-md-6 text-md-start">
        <small class="fw-semibold text-secondary">Sistema Lonja de Veracruz &bull; Web 2 &bull; FES Aragón, UNAM</small>
        <div class="small text-muted">Hector Ardan Montiel Olvera &bull; Jesus Armando Serrano Medina &bull; Mendoza Lemus Leonardo</div>
      </div>
      <div class="col-md-6 text-md-end">
        <a href="/configuracion" class="text-muted small text-decoration-none me-3">Configuración</a>
        <a href="javascript:void(0)" onclick="mostrarModalCookies()" class="text-muted small text-decoration-none">Permisos de Cookies</a>
      </div>
    </div>
  </footer>

  <!-- Botón flotante para Configuración Rápida -->
  <button type="button" class="btn-quick-settings d-print-none" data-bs-toggle="modal" data-bs-target="#modalConfigRapida" title="Configuración rápida">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0"/><path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115z"/></svg>
  </button>

  <!-- Modal de Configuración Rápida -->
  <div class="modal fade" id="modalConfigRapida" tabindex="-1" aria-labelledby="modalConfigLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
        <div class="modal-header border-bottom-0 pb-0">
          <h5 class="modal-title fw-bold" id="modalConfigLabel">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1 text-primary" viewBox="0 0 16 16"><path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0"/></svg>
            <%= t('configuracion_rapida') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small mb-3">Tus preferencias se guardan en cookies seguras y se aplican en tiempo real.</p>
          
          <!-- Tema Visual -->
          <div class="mb-3">
            <label class="form-label small fw-bold"><%= t('tema') %></label>
            <div class="btn-group w-100" role="group">
              <button type="button" class="btn btn-sm <%= pref.tema === 'ocean' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('tema', 'ocean')">🌊 Océano</button>
              <button type="button" class="btn btn-sm <%= pref.tema === 'light' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('tema', 'light')">☀️ Claro</button>
              <button type="button" class="btn btn-sm <%= pref.tema === 'dark' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('tema', 'dark')">🌙 Oscuro</button>
            </div>
          </div>

          <!-- Moneda -->
          <div class="mb-3">
            <label class="form-label small fw-bold"><%= t('moneda') %></label>
            <div class="btn-group w-100" role="group">
              <button type="button" class="btn btn-sm <%= pref.moneda === 'MXN' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('moneda', 'MXN')">MXN ($)</button>
              <button type="button" class="btn btn-sm <%= pref.moneda === 'USD' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('moneda', 'USD')">USD ($)</button>
              <button type="button" class="btn btn-sm <%= pref.moneda === 'EUR' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('moneda', 'EUR')">EUR (€)</button>
            </div>
          </div>

          <!-- Idioma -->
          <div class="mb-3">
            <label class="form-label small fw-bold"><%= t('idioma') %></label>
            <div class="btn-group w-100" role="group">
              <button type="button" class="btn btn-sm <%= pref.idioma === 'es' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('idioma', 'es')">🇲🇽 Español</button>
              <button type="button" class="btn btn-sm <%= pref.idioma === 'en' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('idioma', 'en')">🇺🇸 English</button>
            </div>
          </div>

          <!-- Tamaño de Fuente -->
          <div class="mb-3">
            <label class="form-label small fw-bold"><%= t('tamano_fuente') %></label>
            <div class="btn-group w-100" role="group">
              <button type="button" class="btn btn-sm <%= pref.tamanoFuente === 'sm' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('tamanoFuente', 'sm')">A- Pequeña</button>
              <button type="button" class="btn btn-sm <%= pref.tamanoFuente === 'md' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('tamanoFuente', 'md')">A Normal</button>
              <button type="button" class="btn btn-sm <%= pref.tamanoFuente === 'lg' ? 'btn-primary' : 'btn-outline-secondary' %>" onclick="aplicarPreferencia('tamanoFuente', 'lg')">A+ Grande</button>
            </div>
          </div>

          <!-- Tipo de Fuente -->
          <div class="mb-2">
            <label class="form-label small fw-bold"><%= t('tipo_fuente') %></label>
            <select class="form-select form-select-sm" onchange="aplicarPreferencia('tipoFuente', this.value)">
              <option value="sans" <%= pref.tipoFuente === 'sans' ? 'selected' : '' %>>Inter / Sans Moderna</option>
              <option value="roboto" <%= pref.tipoFuente === 'roboto' ? 'selected' : '' %>>Roboto Google</option>
              <option value="segoe" <%= pref.tipoFuente === 'segoe' ? 'selected' : '' %>>Segoe UI</option>
              <option value="serif" <%= pref.tipoFuente === 'serif' ? 'selected' : '' %>>Serif Clásica</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
          <a href="/configuracion" class="btn btn-sm btn-link text-decoration-none">Ir al panel completo &rarr;</a>
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Banner de Consentimiento de Cookies (si no ha respondido) -->
  <% if (!pref.cookiesRespondidas) { %>
    <div id="cookieConsentBanner" class="cookie-consent-bar d-print-none">
      <div class="d-flex align-items-start gap-3">
        <div class="text-primary fs-3">🍪</div>
        <div class="flex-grow-1">
          <h6 class="fw-bold mb-1"><%= t('cookies_banner_titulo') %></h6>
          <p class="small text-muted mb-0"><%= t('cookies_banner_desc') %></p>
        </div>
      </div>
      <div class="d-flex gap-2 justify-content-end flex-wrap">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="aceptarCookies('essential')"><%= t('cookies_esenciales') %></button>
        <button type="button" class="btn btn-sm btn-primary" onclick="aceptarCookies('all')"><%= t('cookies_aceptar') %></button>
      </div>
    </div>
  <% } %>

  <script>
    function mostrarModalCookies() {
      const banner = document.getElementById('cookieConsentBanner');
      if (banner) {
        banner.scrollIntoView({ behavior: 'smooth' });
      } else {
        const modal = new bootstrap.Modal(document.getElementById('modalConfigRapida'));
        modal.show();
      }
    }
  </script>

  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/lonja-app.js"></script>
</body>
</html>
