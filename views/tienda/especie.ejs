<%- include('../plantillas/header') %>
<%
  const _llenas = Math.round(resumenOpiniones.media || 0);
%>

<div class="tienda-especie">
  <nav class="tienda-migas" aria-label="Ruta">
    <a href="/"><%- icono('arrow-left', 14, 'me-1') %>Volver a la tienda</a>
    <span aria-hidden="true">/</span>
    <span><%= especie.nombre %></span>
  </nav>

  <header class="tienda-especie__cabecera">
    <img src="<%= especie.imagen %>" alt="<%= especie.nombre %>" width="360" height="240">
    <div>
      <span class="tienda-detalle__tipo"><%= especie.tipo %></span>
      <h1><%= especie.nombre %></h1>
      <p class="tienda-especie__desc"><%= especie.descripcion || 'Especie fresca del puerto de Veracruz, disponible en los lotes de la lonja.' %></p>
      <div class="tienda-especie__resumen">
        <span class="tienda-estrellas" aria-label="Calificación media">
          <% for (let i = 1; i <= 5; i += 1) { %><%- icono(i <= _llenas ? 'star-fill' : 'star', 16) %><% } %>
        </span>
        <span class="text-muted small">
          <%= resumenOpiniones.total ? `${resumenOpiniones.media.toFixed(1)} de 5 · ${resumenOpiniones.total} opiniones` : 'Sin opiniones todavía' %>
        </span>
      </div>
      <% if (usuario && usuario.rol === 'comprador') { %><form action="/cuenta/favoritos" method="post" class="mt-2"><input type="hidden" name="tipo" value="especie"><input type="hidden" name="id_ref" value="<%= especie.id %>"><button class="btn btn-outline-secondary btn-sm"><%- icono('heart', 14, 'me-1') %>Guardar especie en Favoritos</button></form><% } %>
    </div>
  </header>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="tienda-detalle__bloque">
        <h2>Distribución de estrellas</h2>
        <% if (!resumenOpiniones.total) { %>
          <p class="text-muted small mb-0">Cuando los compradores califiquen esta especie verás aquí el desglose por estrellas.</p>
        <% } else { %>
          <ul class="tienda-distribucion">
            <% [5, 4, 3, 2, 1].forEach((n) => {
              const cantidad = resumenOpiniones.distribucion[n - 1] || 0;
              const pct = resumenOpiniones.total ? Math.round((cantidad / resumenOpiniones.total) * 100) : 0;
            %>
              <li><span><%= n %> <%- icono('star-fill', 12) %></span><span class="tienda-distribucion__barra"><span style="width: <%= pct %>%"></span></span><span><%= cantidad %></span></li>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <div class="tienda-detalle__bloque">
        <h2>Opiniones</h2>
        <% if (!opiniones.length) { %>
          <p class="text-muted small mb-0">Aún no hay opiniones de esta especie.</p>
        <% } %>
        <% opiniones.forEach((o) => { %><article class="border-bottom py-3"><div><strong><%= o.titulo %></strong> · <%= '★'.repeat(o.estrellas) %> <span class="badge bg-success">Compra verificada</span></div><p class="mb-1"><%= o.texto %></p><small class="text-muted"><%= o.autorPublico || 'Comprador' %></small></article><% }) %>
        <% if (usuario && usuario.rol === 'comprador') { %><form action="/tienda/especie/<%= especie.id %>/opiniones" method="post" class="mt-3"><h3 class="h6">Comparte tu experiencia</h3><label class="form-label" for="estrellas">Calificación (1 a 5)</label><select id="estrellas" name="estrellas" class="form-select" required><option value="">Elige</option><% [5,4,3,2,1].forEach((n) => { %><option value="<%= n %>"><%= n %> estrellas</option><% }) %></select><label class="form-label mt-2" for="opinion-titulo">Título</label><input id="opinion-titulo" name="titulo" maxlength="80" class="form-control" required><label class="form-label mt-2" for="opinion-texto">Tu opinión</label><textarea id="opinion-texto" name="texto" maxlength="1000" rows="3" class="form-control" required></textarea><button class="btn btn-outline-primary mt-2">Guardar opinión</button></form><% } %>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="tienda-detalle__bloque">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
          <h2 class="mb-0">Lotes disponibles</h2>
          <span class="badge bg-secondary"><%= lotes.length %></span>
        </div>
        <% if (!lotes.length) { %>
          <p class="text-muted small mb-0">Ahora mismo no hay lotes disponibles con esta especie. Vuelve a revisar la tienda más tarde.</p>
        <% } else { %>
          <div class="tienda-grid tienda-grid--compacta">
            <% lotes.forEach((lote, i) => { %>
              <%- include('_tarjeta-lote', { lote, posicion: i }) %>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="tienda-toasts" aria-live="polite" aria-atomic="true" data-toasts></div>

<%- include('../plantillas/footer') %>
