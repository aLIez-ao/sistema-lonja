<%- include('../plantillas/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 mb-0 fw-bold">Reporte Diario de Compras</h1>
    <p class="text-muted small mb-0">Fecha seleccionada: <span id="txtTituloFecha" class="fw-semibold text-primary"><%= fecha %></span></p>
  </div>
  
  <div class="d-flex flex-wrap gap-2 d-print-none align-items-center">
    <form class="d-flex gap-2" method="GET" action="/reportes/diario" id="formFiltroFecha">
      <input class="form-control" type="date" id="reporteFechaInput" name="fecha" value="<%= fecha %>" required title="Selecciona una fecha">
      <noscript>
        <button class="btn btn-primary" type="submit">Ver</button>
      </noscript>
    </form>

    <a id="linkExportarCsv" class="btn btn-outline-secondary" href="/reportes/diario.csv?fecha=<%= fecha %>" title="Descargar como archivo CSV">
      <%- icono('download', 15, 'me-1') %>
      CSV
    </a>

    <button class="btn btn-outline-secondary" type="button" onclick="compartirEnlace('Reporte Lonja <%= fecha %>', 'Reporte diario de compras de la Lonja de Veracruz para la fecha <%= fecha %>')" title="Compartir este reporte">
      <%- icono('share', 15, 'me-1') %>
      <%= t('compartir') %>
    </button>

    <button class="btn btn-primary" type="button" onclick="window.print()" title="Imprimir o guardar como PDF">
      <%- icono('printer', 15, 'me-1') %>
      <%= t('descargar_pdf') %>
    </button>
  </div>
</div>

<!-- Barra de Días con Compras Registradas en el Historial -->
<div id="fechasConActividad" class="d-print-none"></div>

<div id="reporteContenedorResultados" style="transition: opacity 0.2s ease;">
  <!-- Métricas Rápidas -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="metric-card">
        <div class="metric-label">Compras</div>
        <div class="metric-value" id="metricaCompras"><%= totales.compras %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="metric-card">
        <div class="metric-label">Cajas Subastadas</div>
        <div class="metric-value" id="metricaCajas"><%= totales.cajas %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="metric-card">
        <div class="metric-label">Kilos Totales</div>
        <div class="metric-value" id="metricaKilos"><%= totales.kilos.toFixed(2) %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="metric-card">
        <div class="metric-label">Importe Total</div>
        <div class="metric-value text-primary" id="metricaTotal"><%= dinero(totales.total) %></div>
      </div>
    </div>
  </div>

  <!-- Alerta sin compras (visible si no hay filas) -->
  <div id="alertaSinCompras" class="alert alert-info <%= !filas.length ? '' : 'd-none' %>" role="alert">
    <div class="d-flex align-items-center">
      <span class="fs-4 me-2">🐟</span>
      <div>
        <strong>No hay compras registradas para este día.</strong>
        <div class="small">Selecciona otra fecha en el calendario o en los botones superiores para consultar actividad.</div>
      </div>
    </div>
  </div>

  <!-- Sección de Tablas de Detalle y Resumen -->
  <div id="seccionTablasDetalle" class="<%= !filas.length ? 'd-none' : '' %>">
    <div class="card mb-4 overflow-hidden">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold">Detalle de Compras del Día</h2>
        <span class="badge bg-light text-dark border">Transacciones de subasta</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover table-striped align-middle">
          <thead>
            <tr>
              <th>Hora</th>
              <th>Lote</th>
              <th>Especies</th>
              <th>Comprador</th>
              <th class="text-end">Cajas</th>
              <th class="text-end">Kilos</th>
              <th class="text-end">Salida/kg</th>
              <th class="text-end">Final/kg</th>
              <th class="text-end">Total</th>
            </tr>
          </thead>
          <tbody id="reporteTablaCuerpo">
            <% filas.forEach(f => { %>
              <tr>
                <td><%= f.hora %></td>
                <td><span class="badge bg-secondary">#<%= f.lote %></span></td>
                <td><strong><%= f.especies %></strong></td>
                <td><%= f.comprador %></td>
                <td class="text-end"><%= f.cajas %></td>
                <td class="text-end"><%= f.kilos.toFixed(2) %></td>
                <td class="text-end text-muted"><%= dinero(f.precio_salida) %></td>
                <td class="text-end fw-bold"><%= dinero(f.precio_final) %></td>
                <td class="text-end text-primary fw-bold"><%= dinero(f.total) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="table-secondary fw-bold">
              <th colspan="4">TOTAL DEL DÍA</th>
              <th class="text-end" id="pieTotalCajas"><%= totales.cajas %></th>
              <th class="text-end" id="pieTotalKilos"><%= totales.kilos.toFixed(2) %></th>
              <th></th>
              <th></th>
              <th class="text-end text-primary" id="pieTotalDinero"><%= dinero(totales.total) %></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Resumen por Comprador -->
    <div class="card overflow-hidden">
      <div class="card-header">
        <h2 class="h6 mb-0 fw-bold">Resumen de Compras por Cliente</h2>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Comprador</th>
              <th class="text-end">Total Compras</th>
              <th class="text-end">Kilos Acumulados</th>
              <th class="text-end">Importe Total Facturado</th>
            </tr>
          </thead>
          <tbody id="reporteResumenCompradores">
            <% resumen.forEach(r => { %>
              <tr>
                <td><strong><%= r.comprador %></strong></td>
                <td class="text-end"><%= r.compras %></td>
                <td class="text-end"><%= r.kilos.toFixed(2) %></td>
                <td class="text-end fw-bold text-primary"><%= dinero(r.total) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../plantillas/footer') %>
