<%- include('../plantillas/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-3">
  <div>
    <h1 class="h3 mb-1 fw-bold">Reporte de compras <%= anio %></h1>
    <p class="text-muted small mb-0">Elige un año para ver su tablero y las compras de cada mes.</p>
  </div>

  <div class="d-flex flex-wrap gap-2 align-items-end d-print-none">
    <form method="GET" action="/reportes/diario" class="m-0">
      <label class="form-label small fw-semibold mb-1" for="selectorAnio">Año</label>
      <select class="form-select" id="selectorAnio" name="anio" onchange="this.form.submit()" style="min-width: 7.5rem;">
        <% aniosDisponibles.forEach(a => { %>
          <option value="<%= a %>" <%= a === anio ? 'selected' : '' %>><%= a %></option>
        <% }) %>
      </select>
      <noscript><button class="btn btn-primary mt-1" type="submit">Ver</button></noscript>
    </form>
    <a class="btn btn-primary" href="/reportes/anual.pdf?anio=<%= anio %>" title="Documento oficial del ejercicio en PDF">
      <%- icono('file-earmark-pdf', 16, 'me-1') %>Reporte oficial (PDF)
    </a>
    <a class="btn btn-outline-secondary" href="/reportes/diario.csv?anio=<%= anio %>" title="Detalle de compras del año en CSV">
      <%- icono('filetype-csv', 16, 'me-1') %>CSV
    </a>
  </div>
</div>

<!-- Indicadores del año -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg">
    <div class="metric-card"><div class="metric-label">Compras</div><div class="metric-value"><%= totalesAnio.compras %></div></div>
  </div>
  <div class="col-6 col-lg">
    <div class="metric-card"><div class="metric-label">Cajas</div><div class="metric-value"><%= totalesAnio.cajas.toLocaleString('es-MX') %></div></div>
  </div>
  <div class="col-6 col-lg">
    <div class="metric-card"><div class="metric-label">Kilos</div><div class="metric-value"><%= totalesAnio.kilos.toLocaleString('es-MX', { maximumFractionDigits: 1 }) %></div></div>
  </div>
  <div class="col-6 col-lg">
    <div class="metric-card"><div class="metric-label">Precio medio / kg</div><div class="metric-value"><%= dinero(totalesAnio.precioPromedio) %></div></div>
  </div>
  <div class="col-12 col-lg-3">
    <div class="metric-card"><div class="metric-label">Importe total</div><div class="metric-value"><%= dinero(totalesAnio.total) %></div>
      <% if (mejorMes) { %><div class="small text-muted">Mejor mes: <%= mejorMes.nombreMes %></div><% } %>
    </div>
  </div>
</div>

<% if (totalesAnio.compras === 0) { %>
  <div class="alert alert-info" role="alert">
    <strong>No hay compras registradas en <%= anio %>.</strong>
    <div class="small">Elige otro año en el selector.</div>
  </div>
<% } else { %>

<script type="application/json" id="datosReporte"><%- jsonSeguro({ ...graficas, etiquetas: graficas.meses, nombresCompradores: graficas.compradores.map(c => c.nombre), totalesCompradores: graficas.compradores.map(c => c.total), nombresEspecies: graficas.especies.map(e => e.nombre), kilosEspecies: graficas.especies.map(e => e.kilos), moneda: monedaInfo }) %></script>

<div class="row g-3 mb-4 d-print-none">
  <div class="col-lg-8">
    <div class="card p-3 h-100">
      <h2 class="h6 fw-bold mb-3">Importe por mes</h2>
      <div class="grafica"><canvas data-grafica="barras" data-fuente="datosReporte" data-serie="importes" data-formato="dinero" role="img" aria-label="Importe de compras por mes de <%= anio %>; los datos están en la tabla Resumen por mes"></canvas></div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card p-3 h-100">
      <h2 class="h6 fw-bold mb-3">Compradores con mayor importe</h2>
      <div class="grafica"><canvas data-grafica="barras-h" data-fuente="datosReporte" data-etiquetas="nombresCompradores" data-serie="totalesCompradores" data-formato="dinero" role="img" aria-label="Cinco compradores con mayor importe en <%= anio %>"></canvas></div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card p-3 h-100">
      <h2 class="h6 fw-bold mb-3">Kilos vendidos por mes</h2>
      <div class="grafica"><canvas data-grafica="barras" data-color="secundario" data-fuente="datosReporte" data-serie="kilos" data-formato="kg" role="img" aria-label="Kilos vendidos por mes de <%= anio %>; los datos están en la tabla Resumen por mes"></canvas></div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card p-3 h-100">
      <h2 class="h6 fw-bold mb-3">Especies con más kilos</h2>
      <div class="grafica"><canvas data-grafica="barras-h" data-color="secundario" data-fuente="datosReporte" data-etiquetas="nombresEspecies" data-serie="kilosEspecies" data-formato="kg" role="img" aria-label="Cinco especies con más kilos vendidos en <%= anio %>"></canvas></div>
    </div>
  </div>
</div>

<!-- Resumen por mes -->
<div class="card mb-4 overflow-hidden">
  <div class="card-header"><h2 class="h6 mb-0 fw-bold">Resumen por mes</h2></div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr><th>Mes</th><th class="text-end">Compras</th><th class="text-end">Cajas</th><th class="text-end">Kilos</th><th class="text-end">Precio medio/kg</th><th class="text-end">Importe</th></tr>
      </thead>
      <tbody>
        <% meses.forEach(m => { %>
          <tr class="<%= m.compras ? '' : 'text-muted' %>">
            <td><% if (m.compras) { %><a class="fw-semibold text-decoration-none" href="#mes-<%= m.numeroMes %>"><%= m.nombreMes %></a><% } else { %><%= m.nombreMes %><% } %></td>
            <td class="text-end"><%= m.compras %></td>
            <td class="text-end"><%= m.cajas %></td>
            <td class="text-end"><%= m.kilos.toFixed(2) %></td>
            <td class="text-end"><%= m.compras ? dinero(m.precioPromedio) : '—' %></td>
            <td class="text-end fw-semibold"><%= dinero(m.total) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="fw-bold">
          <th>Total <%= anio %></th>
          <th class="text-end"><%= totalesAnio.compras %></th>
          <th class="text-end"><%= totalesAnio.cajas %></th>
          <th class="text-end"><%= totalesAnio.kilos.toFixed(2) %></th>
          <th class="text-end"><%= dinero(totalesAnio.precioPromedio) %></th>
          <th class="text-end"><%= dinero(totalesAnio.total) %></th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<!-- Compras de cada mes: cada registro enlaza a la página de su compra -->
<h2 class="h5 fw-bold mb-3">Compras por mes</h2>
<div class="accordion mb-4" id="acordeonMeses">
  <% const ultimoConCompras = [...meses].reverse().find(m => m.compras); %>
  <% meses.filter(m => m.compras).forEach(m => { const abierto = m === ultimoConCompras; %>
    <div class="accordion-item" id="mes-<%= m.numeroMes %>">
      <h3 class="accordion-header">
        <button class="accordion-button <%= abierto ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#detalleMes-<%= m.numeroMes %>" aria-expanded="<%= abierto %>" aria-controls="detalleMes-<%= m.numeroMes %>">
          <span class="fw-bold me-3"><%= m.nombreMes %></span>
          <span class="badge bg-secondary me-2"><%= m.compras %> <%= m.compras === 1 ? 'compra' : 'compras' %></span>
          <span class="text-muted small me-2"><%= m.kilos.toFixed(2) %> kg</span>
          <span class="ms-auto me-3 fw-semibold"><%= dinero(m.total) %></span>
        </button>
      </h3>
      <div id="detalleMes-<%= m.numeroMes %>" class="accordion-collapse collapse <%= abierto ? 'show' : '' %>">
        <div class="table-responsive">
          <table class="table table-hover table-striped align-middle mb-0 table-sortable">
            <thead>
              <tr>
                <th>Fecha</th><th>Compra</th><th>Especies</th><th>Comprador</th>
                <th class="text-end">Cajas</th><th class="text-end">Kilos</th><th class="text-end">Final/kg</th><th class="text-end">Total</th>
              </tr>
            </thead>
            <tbody>
              <% m.filas.forEach(f => { %>
                <tr>
                  <td data-sort-value="<%= f.marca %>" class="text-nowrap"><%= f.fecha %> <span class="text-muted small"><%= f.hora %></span></td>
                  <td><a class="fw-semibold text-decoration-none" href="/compras/<%= f.id_cmp %>/factura" title="Abrir la compra del lote #<%= f.lote %>">Lote #<%= f.lote %></a></td>
                  <td><%= f.especies %></td>
                  <td><%= f.comprador %></td>
                  <td class="text-end"><%= f.cajas %></td>
                  <td class="text-end"><%= f.kilos.toFixed(2) %></td>
                  <td class="text-end"><%= dinero(f.precio_final) %></td>
                  <td class="text-end fw-semibold"><a class="text-decoration-none" href="/compras/<%= f.id_cmp %>/factura"><%= dinero(f.total) %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<script src="/vendor/chartjs/chart.umd.min.js"></script>
<script src="/js/lonja-graficas.js"></script>
<% } %>

<%- include('../plantillas/footer') %>
