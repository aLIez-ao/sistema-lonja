<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Usuarios del sistema</h1>
  <a class="btn btn-primary" href="/usuarios/crear">Nuevo usuario</a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<table class="table table-striped align-middle">
  <thead><tr><th>ID</th><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
  <tbody>
  <% usuarios.forEach(u => { %>
    <tr>
      <td><%= u.id %></td><td><%= u.usuario %></td><td><%= u.nombre_completo %></td><td><%= u.rol %></td>
      <td><%= u.activo ? 'Activo' : 'Inactivo' %></td>
      <td class="text-end">
        <a class="btn btn-sm btn-outline-secondary" href="/usuarios/<%= u.id %>/editar">Editar</a>
        <% if (u.id !== usuario.id) { %>
        <form action="/usuarios/<%= u.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este usuario?')">
          <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<%- include('../plantillas/footer') %>
