<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('usuarios') %> del Sistema</h1>
    <p class="text-muted small mb-0">Cuentas de personal autorizado (Administradores y Capturistas)</p>
  </div>
  <a class="btn btn-primary" href="/usuarios/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    Nuevo usuario
  </a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0 table-sortable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuario</th>
          <th>Nombre</th>
          <th>Correo</th>
          <th>Rol</th>
          <th>Estado</th>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% usuarios.forEach(u => { %>
        <tr>
          <td><span class="badge bg-secondary">#<%= u.id %></span></td>
          <td><strong><%= u.usuario %></strong></td>
          <td><%= u.nombre_completo %></td>
          <td>
            <% if (u.correo) { %>
              <%= u.correo %>
              <% if (u.email_verificado) { %><span class="badge bg-success ms-1">✓</span><% } %>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td><span class="badge bg-light text-dark border text-uppercase"><%= u.rol %></span></td>
          <td>
            <% if (u.activo) { %>
              <span class="badge bg-success">Activo</span>
            <% } else { %>
              <span class="badge bg-danger">Inactivo</span>
            <% } %>
          </td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-secondary" href="/usuarios/<%= u.id %>/editar" title="Editar usuario">
              <%- icono('pencil', 14) %>
            </a>
            <% if (u.id !== usuario.id) { %>
            <form action="/usuarios/<%= u.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este usuario?')">
              <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar usuario" aria-label="Eliminar usuario">
                <%- icono('trash', 14) %>
              </button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../plantillas/footer') %>
