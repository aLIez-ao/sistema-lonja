<%- include('../plantillas/header') %>
<div class="mb-4"><p class="text-uppercase small text-muted fw-semibold mb-1">Pedido #<%= pedido.id_ped %></p><h1 class="h2 mb-0">Pago de prueba</h1></div>
<div class="alert alert-warning" role="alert"><strong>PAGO SIMULADO: no se realiza ningún cargo.</strong> Usa una tarjeta de prueba. No escribas datos reales.</div>
<%- include('../plantillas/mensajes', { mensaje: null, errores: error ? [error] : [] }) %>
<div class="row g-4">
  <div class="col-lg-7">
    <div class="card p-4">
      <form action="/pedido/<%= pedido.id_ped %>/pagar" method="POST" data-pago-simulado>
        <h2 class="h5">Datos de prueba</h2>
        <div class="mb-3"><label class="form-label" for="numero">Número de tarjeta</label><input class="form-control" id="numero" name="numero" inputmode="numeric" autocomplete="cc-number" maxlength="23" required></div>
        <div class="row g-3 mb-3">
          <div class="col-4"><label class="form-label" for="mes">Mes</label><input class="form-control" id="mes" name="mes" inputmode="numeric" maxlength="2" placeholder="MM" required></div>
          <div class="col-4"><label class="form-label" for="anio">Año</label><input class="form-control" id="anio" name="anio" inputmode="numeric" maxlength="4" placeholder="AAAA" required></div>
          <div class="col-4"><label class="form-label" for="cvv">CVV</label><input class="form-control" id="cvv" name="cvv" inputmode="numeric" autocomplete="off" maxlength="4" required></div>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-4">
          <button class="btn btn-sm btn-outline-primary" type="button" data-tarjeta-prueba="4242424242424242">Usar tarjeta de prueba aprobada</button>
          <button class="btn btn-sm btn-outline-secondary" type="button" data-tarjeta-prueba="4000000000000002">Usar tarjeta rechazada</button>
        </div>
        <button class="btn btn-primary btn-lg w-100" type="submit">Pagar <%= dinero(pedido.total) %> (simulado)</button>
      </form>
      <form action="/pedido/<%= pedido.id_ped %>/cancelar" method="POST" class="mt-3"><button class="btn btn-link text-danger px-0" type="submit">Cancelar pedido y liberar los lotes</button></form>
    </div>
  </div>
  <aside class="col-lg-5">
    <div class="card p-4">
      <h2 class="h5">Resumen</h2>
      <% items.forEach((i) => { %><div class="d-flex justify-content-between gap-2 py-2 border-top"><span>Lote #<%= i.id_lte %> · <%= Number(i.kilos).toFixed(2) %> kg</span><span><%= dinero(i.subtotal) %></span></div><% }) %>
      <div class="d-flex justify-content-between py-2 border-top"><span>Subtotal</span><span><%= dinero(pedido.subtotal) %></span></div>
      <div class="d-flex justify-content-between py-2"><span>Envío</span><span><%= dinero(pedido.costo_envio) %></span></div>
      <div class="d-flex justify-content-between py-2 border-top fs-5"><strong>Total</strong><strong><%= dinero(pedido.total) %></strong></div>
      <p class="small text-muted mb-0">Reserva hasta <time data-reserva-hasta="<%= vence %>"><%= fechaHora(pedido.reservado_hasta) %></time> (<span data-cuenta-regresiva>calculando…</span>).</p>
    </div>
  </aside>
</div>
<script>
  document.querySelectorAll('[data-tarjeta-prueba]').forEach((b) => b.addEventListener('click', () => {
    const f = b.closest('.card').querySelector('form[data-pago-simulado]');
    f.elements.numero.value = b.dataset.tarjetaPrueba; f.elements.mes.value = '12';
    f.elements.anio.value = String(new Date().getFullYear() + 2); f.elements.cvv.value = '123';
  }));
  const salida = document.querySelector('[data-cuenta-regresiva]');
  const vence = new Date(document.querySelector('[data-reserva-hasta]').dateTime || document.querySelector('[data-reserva-hasta]').dataset.reservaHasta).getTime();
  const actualizar = () => { const s = Math.max(0, Math.floor((vence - Date.now()) / 1000)); salida.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; if (!s) window.location.reload(); };
  actualizar(); setInterval(actualizar, 1000);
</script>
<%- include('../plantillas/footer') %>
