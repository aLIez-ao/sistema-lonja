<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('tipos') %></h1>
    <p class="text-muted small mb-0">Categorías biológicas principales (Pescado, Marisco, Molusco)</p>
  </div>
  <a class="btn btn-primary" href="/tipos/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    Nuevo tipo
  </a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0 table-sortable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre de Categoría</th>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% tipos.forEach(t => { %>
        <tr>
          <td><span class="badge bg-secondary">#<%= t.id_tpo %></span></td>
          <td><strong><%= t.nombre %></strong></td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-secondary" href="/tipos/<%= t.id_tpo %>/editar" title="Editar tipo">
              <%- icono('pencil', 14) %>
            </a>
            <% if (usuario.rol === 'admin') { %>
            <form action="/tipos/<%= t.id_tpo %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este tipo?')">
              <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar tipo" aria-label="Eliminar tipo">
                <%- icono('trash', 14) %>
              </button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../plantillas/footer') %>
