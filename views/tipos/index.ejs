<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Tipos de especie</h1>
  <a class="btn btn-primary" href="/tipos/crear">Nuevo tipo</a>
</div>
<%- include('../plantillas/mensajes', { errores: [] }) %>
<table class="table table-striped align-middle">
  <thead><tr><th>ID</th><th>Nombre</th><th class="text-end">Acciones</th></tr></thead>
  <tbody>
  <% tipos.forEach(t => { %>
    <tr>
      <td><%= t.id_tpo %></td><td><%= t.nombre %></td>
      <td class="text-end">
        <a class="btn btn-sm btn-outline-secondary" href="/tipos/<%= t.id_tpo %>/editar">Editar</a>
        <% if (usuario.rol === 'admin') { %>
        <form action="/tipos/<%= t.id_tpo %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este tipo?')">
          <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<%- include('../plantillas/footer') %>
