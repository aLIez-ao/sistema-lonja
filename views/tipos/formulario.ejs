<%- include('../plantillas/header') %>
<h1 class="h3 mb-3"><%= tipo && tipo.id_tpo ? 'Editar' : 'Nuevo' %> tipo</h1>
<%- include('../plantillas/mensajes', { mensaje: null }) %>
<form action="<%= action %>" method="<%= method %>" class="col-md-6">
  <div class="mb-3">
    <label class="form-label" for="nombre">Nombre</label>
    <input class="form-control" id="nombre" name="nombre" maxlength="30" value="<%= tipo ? tipo.nombre : '' %>" required>
  </div>
  <button class="btn btn-primary" type="submit">Guardar</button>
  <a class="btn btn-link" href="/tipos">Cancelar</a>
</form>
<%- include('../plantillas/footer') %>
