<%- include('../plantillas/header') %>
<h1 class="h3 mb-3"><%= comprador && comprador.codigo_cpr ? 'Editar' : 'Nuevo' %> comprador</h1>
<%- include('../plantillas/mensajes', { mensaje: null }) %>
<form action="<%= action %>" method="POST" class="col-lg-8">
  <div class="row g-3">
    <div class="col-md-4"><label class="form-label" for="nombre">Nombre</label>
      <input class="form-control" id="nombre" name="nombre" maxlength="15" value="<%= comprador ? comprador.nombre : '' %>" required></div>
    <div class="col-md-4"><label class="form-label" for="apellido_paterno">Apellido paterno</label>
      <input class="form-control" id="apellido_paterno" name="apellido_paterno" maxlength="15" value="<%= comprador ? comprador.apellido_paterno : '' %>" required></div>
    <div class="col-md-4"><label class="form-label" for="apellido_materno">Apellido materno</label>
      <input class="form-control" id="apellido_materno" name="apellido_materno" maxlength="15" value="<%= comprador ? (comprador.apellido_materno || '') : '' %>"></div>
    <div class="col-md-6"><label class="form-label" for="correo">Correo</label>
      <input class="form-control" type="email" id="correo" name="correo" maxlength="80" value="<%= comprador ? comprador.correo : '' %>" required></div>
    <div class="col-md-6"><label class="form-label" for="direccion">Dirección</label>
      <input class="form-control" id="direccion" name="direccion" maxlength="200" value="<%= comprador ? (comprador.direccion || '') : '' %>"></div>
  </div>
  <div class="mt-3">
    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-link" href="/compradores">Cancelar</a>
  </div>
</form>
<%- include('../plantillas/footer') %>
