<%- include('../plantillas/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Compradores</h1>
  <a class="btn btn-primary" href="/compradores/crear">Nuevo comprador</a>
</div>

<%- include('../plantillas/mensajes', { errores: [] }) %>

<div class="table-responsive">

<table class="table table-striped align-middle">

  <thead><tr><th>Código</th><th>Nombre</th><th>Correo</th><th>Dirección</th><th>Compras</th><th class="text-end">Acciones</th></tr></thead>

  <tbody>
  <% compradores.forEach(c => { %>
    <tr>
      <td><%= c.codigo_cpr %></td>
      <td><%= c.nombre %> <%= c.apellido_paterno %> <%= c.apellido_materno || '' %></td>
      <td><%= c.correo %></td>
      <td><%= c.direccion || '—' %></td>
      <td><%= c.compras.length %></td>
      <td class="text-end">
        <a class="btn btn-sm btn-outline-secondary" href="/compradores/<%= c.codigo_cpr %>/editar">Editar</a>
        <% if (usuario.rol === 'admin') { %>
        <form action="/compradores/<%= c.codigo_cpr %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este comprador?')">
          <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>

  </tbody>
  
</table>

</div>

<%- include('../plantillas/footer') %>
