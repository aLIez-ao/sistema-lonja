<%- include('../plantillas/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('compradores') %></h1>
    <p class="text-muted small mb-0">Compradores acreditados para subastas en lonja</p>
  </div>
  <a class="btn btn-primary" href="/compradores/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    Nuevo comprador
  </a>
</div>

<%- include('../plantillas/mensajes', { errores: [] }) %>

<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0" data-orden-servidor>
      <thead>
        <tr>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'codigo', titulo: 'Código' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'nombre', titulo: 'Nombre' }) %>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'correo', titulo: 'Correo' }) %>
          <th>Dirección</th>
          <%- include('../plantillas/encabezado-orden', { l, campo: 'compras', titulo: 'Compras', claseExtra: 'text-end' }) %>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% if (!compradores.length) { %>
        <tr class="fila-vacia">
          <td colspan="6" class="text-center py-4 text-muted">
            <%= (l.q || Object.keys(l.filtros).length) ? 'No hay registros que coincidan con la búsqueda.' : 'No hay compradores registrados en el sistema.' %>
          </td>
        </tr>
      <% } %>
      <% compradores.forEach(c => { %>
        <tr>
          <td><span class="badge bg-secondary">#<%= c.codigo_cpr %></span></td>
          <td><strong><%= c.nombre %> <%= c.apellido_paterno %> <%= c.apellido_materno || '' %></strong></td>
          <td><%= c.correo %></td>
          <td><%= c.direccion || '—' %></td>
          <td class="text-end fw-semibold"><%= c.compras.length %></td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-secondary" href="/compradores/<%= c.codigo_cpr %>/editar" title="Editar comprador" aria-label="Editar comprador">
              <%- icono('pencil', 14) %>
            </a>
            <% if (usuario.rol === 'admin') { %>
            <form action="/compradores/<%= c.codigo_cpr %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este comprador?')">
              <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar comprador" aria-label="Eliminar comprador">
                <%- icono('trash', 14) %>
              </button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../plantillas/paginacion', { l, etiqueta: 'compradores' }) %>

<%- include('../plantillas/footer') %>
