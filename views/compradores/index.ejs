<%- include('../plantillas/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0 fw-bold"><%= t('compradores') %></h1>
    <p class="text-muted small mb-0">Compradores acreditados para subastas en lonja</p>
  </div>
  <a class="btn btn-primary" href="/compradores/crear">
    <%- icono('plus-lg', 16, 'me-1') %>
    Nuevo comprador
  </a>
</div>

<%- include('../plantillas/mensajes', { errores: [] }) %>

<div class="card overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover table-striped align-middle mb-0 table-sortable">
      <thead>
        <tr>
          <th>Código</th>
          <th>Nombre</th>
          <th>Correo</th>
          <th>Dirección</th>
          <th class="text-end">Compras</th>
          <th class="text-end" data-no-sort>Acciones</th>
        </tr>
      </thead>
      <tbody>
      <% compradores.forEach(c => { %>
        <tr>
          <td><span class="badge bg-secondary">#<%= c.codigo_cpr %></span></td>
          <td><strong><%= c.nombre %> <%= c.apellido_paterno %> <%= c.apellido_materno || '' %></strong></td>
          <td><%= c.correo %></td>
          <td><%= c.direccion || '—' %></td>
          <td class="text-end fw-semibold"><%= c.compras.length %></td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-secondary" href="/compradores/<%= c.codigo_cpr %>/editar" title="Editar comprador">
              <%- icono('pencil', 14) %>
            </a>
            <% if (usuario.rol === 'admin') { %>
            <form action="/compradores/<%= c.codigo_cpr %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este comprador?')">
              <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar comprador" aria-label="Eliminar comprador">
                <%- icono('trash', 14) %>
              </button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../plantillas/footer') %>
