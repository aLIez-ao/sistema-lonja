# --- Base de datos (MariaDB) ---
BD_NOMBRE=lonja_veracruz
BD_USUARIO=root
BD_CLAVE=1234
BD_DIALEC=mariadb
BD_HOST=127.0.0.1
BD_PORT=3306
# Zona horaria que usa Sequelize al leer/escribir fechas (Ciudad de México = -06:00)
BD_TIMEZONE=-06:00
# Qué hacer con las tablas al arrancar: safe (crea las que falten) | alter | force (BORRA TODO) 
BD_SYNC=safe

# --- Aplicación ---
PORT=2800
APP_TZ=America/Mexico_City
# URL pública con la que se arman los enlaces de los correos (verificación, recuperación).
# En local: http://localhost:2800 | En producción: https://tu-dominio.com (sin diagonal final)
APP_URL=http://localhost:2800
# Firma del JSON Web Token: cámbiala por una cadena larga y aleatoria
SC_JWT=cambia_esta_clave_por_una_larga_y_aleatoria
# Duración de la sesión (formato de jsonwebtoken: 8h, 1d, 30m...)
JWT_DURACION=8h

# --- Usuario administrador inicial (se crea si no existe) ---
ADMIN_USER=administrador
ADMIN_PASSWORD=CambiaEstaClave123

# --- Servicio de Correo Gmail (para verificación, recuperación y avisos a clientes) ---
# En tu cuenta de Google, activa 'Verificación en 2 pasos' y genera una 'Contraseña de aplicación'
GMAIL_USER=tu_cuenta@gmail.com
GMAIL_PASS=tu_contraseña_de_aplicacion_de_16_digitos
